# flutter-ship: shared fastlane lanes for Flutter apps.
#
# Each app's fastlane/Fastfile imports this file (see templates/app/fastlane/Fastfile).
#   - App settings:      <app>/fastlane/ship.yml
#   - Machine settings:  ~/.ship/config.yml
#   - Secrets:           ~/.ship/vault, a private git repo holding AES-256-GCM encrypted
#                        upload keystores and Play service account keys, so every machine
#                        builds with the same keys. Its passphrase lives in ~/.ship/vault.pass
#                        (or SHIP_VAULT_PASSWORD) and in the owner's password manager.
#                        One vault serves every store account: ship.yml names the Play
#                        service account and the App Store Connect key each app ships with.
#
# Version codes come from Google Play itself (highest code ever uploaded + 1), so builds made
# on different machines never collide.

require 'yaml'
require 'json'
require 'net/http'
require 'open3'
require 'openssl'
require 'securerandom'
require 'tmpdir'
require 'fileutils'
require 'socket'
require 'time'
require 'date'

module Ship
  HOME = File.join(Dir.home, '.ship')
  CONFIG_FILE = File.join(HOME, 'config.yml')
  WINDOWS = Gem.win_platform?

  # Google Play limits, checked before anything is uploaded.
  TITLE_MAX = 30
  SHORT_MAX = 80
  FULL_MAX = 4000
  CHANGELOG_MAX = 500
  SCREENSHOT_DIRS = %w[phoneScreenshots sevenInchScreenshots tenInchScreenshots].freeze

  module_function

  # ---------------------------------------------------------------- config

  def fastlane_dir
    File.expand_path(FastlaneCore::FastlaneFolder.path)
  end

  def root
    File.expand_path('..', fastlane_dir)
  end

  def machine
    @machine ||= File.exist?(CONFIG_FILE) ? (YAML.safe_load(File.read(CONFIG_FILE), permitted_classes: [Date]) || {}) : {}
  end

  def app
    @app ||= begin
      path = File.join(fastlane_dir, 'ship.yml')
      UI.user_error!("Missing #{path}. Run the ship-init skill.") unless File.exist?(path)
      YAML.safe_load(File.read(path)) || {}
    end
  end

  def package
    app['package_name'] || UI.user_error!('package_name is missing from fastlane/ship.yml')
  end

  def play
    { 'track' => 'internal', 'release_status' => 'draft', 'service_account' => 'default' }
      .merge(app['play'] || {})
  end

  def locales
    app['locales'] || ['en-US']
  end

  def metadata_dir
    File.join(fastlane_dir, 'metadata', 'android')
  end

  # "version: 1.2.3+45" in pubspec.yaml -> ["1.2.3", 45]. A Unity project has no pubspec: its version
  # name and Android version code come from ProjectSettings (bundleVersion, AndroidBundleVersionCode).
  def pubspec_version
    pubspec = File.join(root, 'pubspec.yaml')
    return unity_version if !File.exist?(pubspec) && File.exist?(unity_settings_path)

    line = File.read(pubspec)[/^version:\s*(\S+)/, 1]
    UI.user_error!('pubspec.yaml has no version line') unless line
    name, build = line.split('+')
    [name, build.to_i]
  end

  def unity_settings_path
    File.join(root, 'ProjectSettings', 'ProjectSettings.asset')
  end

  def unity_version
    text = File.read(unity_settings_path)
    name = text[/^\s*bundleVersion:\s*(\S+)/, 1] || UI.user_error!('ProjectSettings.asset has no bundleVersion')
    [name, text[/^\s*AndroidBundleVersionCode:\s*(\d+)/, 1].to_i]
  end

  # ---------------------------------------------------------------- shell helpers

  def capture!(*cmd, env: {})
    out, status = Open3.capture2e(env, *cmd)
    UI.user_error!("#{File.basename(cmd.first.to_s)} failed:\n#{out}") unless status.success?
    out
  end

  def with_env(vars)
    old = vars.keys.to_h { |k| [k, ENV[k]] }
    vars.each { |k, v| ENV[k] = v }
    yield
  ensure
    old&.each { |k, v| ENV[k] = v }
  end

  def keytool
    @keytool ||= begin
      exe = WINDOWS ? 'keytool.exe' : 'keytool'
      program_files = ENV['ProgramFiles'].to_s.tr('\\', '/')
      dirs = []
      dirs << File.join(ENV['JAVA_HOME'], 'bin') if ENV['JAVA_HOME']
      dirs += ENV['PATH'].to_s.split(File::PATH_SEPARATOR)
      dirs += [
        File.join(ENV['LOCALAPPDATA'].to_s, 'Programs', 'Android Studio', 'jbr', 'bin'),
        File.join(program_files, 'Android', 'Android Studio', 'jbr', 'bin'),
        '/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin',
        '/opt/android-studio/jbr/bin'
      ]
      dirs += Dir.glob(File.join(program_files, 'Java', '*', 'bin')) unless program_files.empty?
      found = dirs.map { |d| File.join(d, exe) }.find { |p| File.file?(p) }
      found || UI.user_error!('keytool not found. Install Android Studio or a JDK, or set JAVA_HOME.')
    end
  end

  def sha256_in(keytool_output)
    keytool_output[/SHA-?256:\s*([0-9A-F:]{95})/, 1]
  end

  # ---------------------------------------------------------------- vault

  module Vault
    MAGIC = 'SHIPV1'.b
    ITERATIONS = 200_000
    CHECK_FILE = '.check.enc'

    module_function

    def keystore_path(pkg) = "android/#{pkg}/upload.jks.enc"
    def signing_path(pkg) = "android/#{pkg}/signing.json.enc"
    def info_path(pkg) = "android/#{pkg}/info.yml"
    def play_key_path(name) = "google-play/#{name}.json.enc"

    # CI checks the vault out itself and points SHIP_VAULT_DIR at it.
    def local_dir
      ENV['SHIP_VAULT_DIR'].to_s.empty? ? File.join(HOME, 'vault') : ENV['SHIP_VAULT_DIR']
    end

    def pass_file
      File.join(HOME, 'vault.pass')
    end

    def repo_url
      Ship.machine['vault_repo'] ||
        UI.user_error!("Set vault_repo in #{CONFIG_FILE} (the ship-setup skill does this).")
    end

    def passphrase
      @passphrase ||= begin
        pass = ENV['SHIP_VAULT_PASSWORD'].to_s
        pass = File.read(pass_file).strip if pass.empty? && File.exist?(pass_file)
        if pass.empty?
          UI.user_error!("No vault passphrase on this machine. Copy it from your password manager into #{pass_file}.")
        end
        pass
      end
    end

    def git(*args, allow_failure: false)
      out, status = Open3.capture2e('git', '-C', local_dir, *args)
      UI.user_error!("git #{args.join(' ')} failed in #{local_dir}:\n#{out}") unless status.success? || allow_failure
      [out, status.success?]
    end

    # Clones the vault on first use and pulls on every run, so all machines share one set of keys.
    def sync!
      return if @synced
      if Dir.exist?(File.join(local_dir, '.git'))
        _, has_commits = git('rev-parse', '--verify', 'HEAD', allow_failure: true)
        if has_commits
          _, ok = git('pull', '--rebase', '--quiet', allow_failure: true)
          UI.important('Could not pull the vault (offline?). Using the local copy.') unless ok
        end
      else
        FileUtils.mkdir_p(File.dirname(local_dir))
        out, status = Open3.capture2e('git', 'clone', '--quiet', repo_url, local_dir)
        UI.user_error!("Could not clone the vault #{repo_url}:\n#{out}") unless status.success?
      end
      check_passphrase!
      @synced = true
    end

    # A small known file proves the passphrase before any real secret is touched.
    def check_passphrase!
      path = File.join(local_dir, CHECK_FILE)
      if File.exist?(path)
        decrypt(File.binread(path))
      else
        File.binwrite(path, encrypt('flutter-ship vault'))
        attributes = File.join(local_dir, '.gitattributes')
        File.write(attributes, "*.enc binary
") unless File.exist?(attributes)
        publish!('Initialise vault')
      end
    end

    def derive(salt)
      OpenSSL::PKCS5.pbkdf2_hmac(passphrase, salt, ITERATIONS, 32, 'sha256')
    end

    # Layout: MAGIC | salt(16) | iv(12) | tag(16) | ciphertext
    def encrypt(data)
      salt = SecureRandom.random_bytes(16)
      iv = SecureRandom.random_bytes(12)
      cipher = OpenSSL::Cipher.new('aes-256-gcm').encrypt
      cipher.key = derive(salt)
      cipher.iv = iv
      cipher.auth_data = MAGIC
      body = cipher.update(data.b) + cipher.final
      MAGIC + salt + iv + cipher.auth_tag + body
    end

    def decrypt(blob)
      blob = blob.b
      UI.user_error!('Not a flutter-ship vault file') unless blob.start_with?(MAGIC)
      cipher = OpenSSL::Cipher.new('aes-256-gcm').decrypt
      cipher.key = derive(blob[6, 16])
      cipher.iv = blob[22, 12]
      cipher.auth_tag = blob[34, 16]
      cipher.auth_data = MAGIC
      cipher.update(blob[50..]) + cipher.final
    rescue OpenSSL::Cipher::CipherError
      UI.user_error!("The vault passphrase in #{pass_file} is wrong, or the file is damaged.")
    end

    def exist?(rel)
      File.exist?(File.join(local_dir, rel))
    end

    def read(rel)
      path = File.join(local_dir, rel)
      UI.user_error!("The vault has no #{rel}") unless File.exist?(path)
      decrypt(File.binread(path))
    end

    def write(rel, data)
      path = File.join(local_dir, rel)
      FileUtils.mkdir_p(File.dirname(path))
      File.binwrite(path, encrypt(data))
    end

    def write_plain(rel, text)
      path = File.join(local_dir, rel)
      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, text)
    end

    # Commits and pushes. A secret that only exists on one machine is the problem the vault
    # solves, so a failed push stops the run.
    def publish!(message)
      git('add', '-A')
      _, clean = git('diff', '--cached', '--quiet', allow_failure: true)
      return if clean
      git('commit', '--quiet', '-m', "#{message} (#{Socket.gethostname})")
      out, ok = git('push', '--quiet', '-u', 'origin', 'HEAD', allow_failure: true)
      return if ok
      UI.user_error!("Saved in #{local_dir} but not pushed:\n#{out}\nRun `git -C #{local_dir} push` once online.")
    end

    # Decrypts a vault file into a private temp dir that is removed after the block.
    def with_file(rel, name)
      dir = Dir.mktmpdir('ship-')
      path = File.join(dir, name)
      File.binwrite(path, read(rel))
      yield path
    ensure
      FileUtils.rm_rf(dir) if dir
    end
  end

  # ---------------------------------------------------------------- signing

  def signing_data
    JSON.parse(Vault.read(Vault.signing_path(package)))
  end

  def keystore?
    Vault.exist?(Vault.keystore_path(package))
  end

  def require_keystore!
    return if keystore?
    UI.user_error!("The vault has no upload key for #{package}. Create one with `bundle exec fastlane android keystore`, " \
                   'or import the existing one with `bundle exec fastlane android keystore import:path/to/key.jks`.')
  end

  # Name on new keys and certificates. owner_name in ship.yml wins, for apps on a client's accounts.
  def owner
    app['owner_name'] || machine['owner_name'] || 'Unknown'
  end

  def save_keystore!(jks_bytes, data, note)
    Vault.write(Vault.keystore_path(package), jks_bytes)
    Vault.write(Vault.signing_path(package), JSON.pretty_generate(data))
    Vault.write_plain(Vault.info_path(package), {
      'package_name' => package,
      'alias' => data['alias'],
      'sha256' => data['sha256'],
      'created_at' => data['created_at'],
      'created_on' => Socket.gethostname
    }.to_yaml)
    Vault.publish!("#{note} for #{package}")
  end

  def create_keystore!
    UI.user_error!("The vault already has an upload key for #{package}.") if keystore?
    password = SecureRandom.alphanumeric(32)
    Dir.mktmpdir('ship-') do |dir|
      path = File.join(dir, 'upload.jks')
      env = { 'SHIP_KS_PASS' => password }
      capture!(keytool, '-J-Duser.language=en', '-genkeypair', '-keystore', path, '-storetype', 'PKCS12',
               '-alias', 'upload', '-keyalg', 'RSA', '-keysize', '4096', '-validity', '10000',
               '-dname', "CN=#{owner}, O=#{owner}", '-storepass:env', 'SHIP_KS_PASS',
               '-keypass:env', 'SHIP_KS_PASS', env: env)
      out = capture!(keytool, '-J-Duser.language=en', '-list', '-v', '-keystore', path,
                     '-alias', 'upload', '-storepass:env', 'SHIP_KS_PASS', env: env)
      data = { 'alias' => 'upload', 'password' => password, 'key_password' => password,
               'sha256' => sha256_in(out), 'created_at' => Time.now.utc.iso8601 }
      save_keystore!(File.binread(path), data, 'Create upload key')
    end
  end

  # An existing app's key.properties (storeFile, storePassword, keyPassword, keyAlias), so the
  # import needs no typing. storeFile resolves like Gradle's file() in android/app, else from
  # the file's own folder or the home folder.
  def keystore_properties(path)
    UI.user_error!("No file at #{path}") unless File.file?(path)
    props = File.read(path).lines.filter_map do |l|
      k, v = l.strip.split('=', 2)
      [k.strip, v.strip] if v && !k.start_with?('#')
    end.to_h
    store = props['storeFile'] || UI.user_error!("#{path} has no storeFile")
    store = [File.join(root, 'android', 'app'), File.dirname(path), Dir.home]
            .map { |d| File.expand_path(store, d) }.find { |f| File.file?(f) } || store
    { path: store, alias: props['keyAlias'], password: props['storePassword'], key_password: props['keyPassword'] }
  end

  def import_keystore!(path, key_alias, store_pass: nil, key_pass: nil)
    UI.user_error!("The vault already has an upload key for #{package}.") if keystore?
    UI.user_error!("No file at #{path}") unless File.file?(path)
    store_pass ||= UI.password('Keystore password:')
    env = { 'SHIP_KS_PASS' => store_pass }
    listing = capture!(keytool, '-J-Duser.language=en', '-list', '-keystore', path,
                       '-storepass:env', 'SHIP_KS_PASS', env: env)
    aliases = listing.scan(/^([^,\n]+),.*(?:PrivateKeyEntry|keyEntry)/i).flatten.map(&:strip)
    key_alias ||= aliases.size == 1 ? aliases.first : UI.select('Which key is the upload key?', aliases)
    key_pass ||= UI.password('Key password (press Enter if it is the same):')
    key_pass = store_pass if key_pass.to_s.empty?
    out = capture!(keytool, '-J-Duser.language=en', '-list', '-v', '-keystore', path, '-alias', key_alias,
                   '-storepass:env', 'SHIP_KS_PASS', env: env)
    data = { 'alias' => key_alias, 'password' => store_pass, 'key_password' => key_pass,
             'sha256' => sha256_in(out), 'created_at' => Time.now.utc.iso8601, 'imported_from' => File.basename(path) }
    save_keystore!(File.binread(path), data, 'Import upload key')
  end

  # Yields the environment variables the app's Gradle signing config reads.
  def with_signing
    data = signing_data
    Vault.with_file(Vault.keystore_path(package), 'upload.jks') do |path|
      yield({
        'SHIP_KEYSTORE_PATH' => path,
        'SHIP_KEYSTORE_PASSWORD' => data['password'],
        'SHIP_KEY_ALIAS' => data['alias'],
        'SHIP_KEY_PASSWORD' => data['key_password'] || data['password']
      })
    end
  end

  def verify_signature!(aab)
    actual = sha256_in(capture!(keytool, '-J-Duser.language=en', '-printcert', '-jarfile', aab))
    expected = signing_data['sha256']
    return if actual == expected
    UI.user_error!("#{aab} is signed with #{actual || 'no key'}, not the upload key #{expected}. " \
                   'Check the SHIP_KEYSTORE_* signing config in android/app/build.gradle(.kts).')
  end

  # ---------------------------------------------------------------- Google Play

  # Service account JSON from SHIP_PLAY_JSON (CI) or the vault.
  def play_key?
    ENV['SHIP_PLAY_JSON'].to_s != '' || Vault.exist?(Vault.play_key_path(play['service_account']))
  end

  def with_play_key(&block)
    return yield(ENV['SHIP_PLAY_JSON']) if ENV['SHIP_PLAY_JSON'].to_s != ''
    name = play['service_account']
    rel = Vault.play_key_path(name)
    unless Vault.exist?(rel)
      UI.user_error!("The vault has no Play service account '#{name}'. " \
                     'Add it with `bundle exec fastlane vault_add_play_key path:/path/to/key.json`.')
    end
    Vault.with_file(rel, 'play.json', &block)
  end

  def play_client(json_key)
    require 'supply'
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options, { package_name: package, json_key: json_key }
    )
    Supply::Client.make_from_config
  end

  # Opens an edit, yields the client, always discards the edit unless the block committed it.
  def with_edit(json_key)
    client = play_client(json_key)
    client.begin_edit(package_name: package)
    yield client
  ensure
    begin
      client&.abort_current_edit if client&.current_edit
    rescue StandardError
      nil
    end
  end

  def app_missing_error?(error)
    error.message =~ /package not found|applicationNotFound|not found: #{Regexp.escape(package)}/i
  end

  # Every version code Play has seen for this app, or nil when Play does not know the app yet.
  def play_version_codes(json_key)
    with_edit(json_key) do |client|
      codes = client.aab_version_codes + client.apks_version_codes
      client.tracks.each do |track|
        (track.releases || []).each { |release| codes.concat(release.version_codes || []) }
      end
      codes.map(&:to_i)
    end
  rescue StandardError => e
    return nil if app_missing_error?(e)
    raise
  end

  # [version_code, known_to_play]
  def next_version_code(json_key)
    _, pubspec_build = pubspec_version
    codes = play_version_codes(json_key)
    return [[pubspec_build, 1].max, false] if codes.nil?
    [[(codes.max || 0) + 1, pubspec_build, shared_floor { asc_next_build }].max, true]
  end

  # An app on both stores gets one build number for both, so 1.0.0 (8) is the same
  # build on Play and on the App Store: the next number is past the highest that
  # either store has seen. Returns 0 when the app is on one store only.
  def shared_floor
    return 0 unless app['ios'] && play_key? && Vault.exist?(Vault.asc_key_path(ios['asc_key']))
    yield || 0
  rescue StandardError => e
    UI.important("Could not read the other store's build numbers (#{e.message}): Android and iOS may get different numbers.")
    0
  end

  def track_releases(json_key)
    with_edit(json_key) do |client|
      client.tracks.flat_map do |track|
        (track.releases || []).map do |r|
          { track: track.track, name: r.name, status: r.status, codes: (r.version_codes || []).map(&:to_i),
            fraction: r.user_fraction }
        end
      end
    end
  end

  def latest_code_on(json_key, track)
    track_releases(json_key).select { |r| r[:track] == track }.flat_map { |r| r[:codes] }.max
  end

  # Contact details live outside the listing, so supply does not send them.
  def update_details(json_key)
    contact = app['contact'] || {}
    return if contact.compact.empty?
    with_edit(json_key) do |client|
      details = Google::Apis::AndroidpublisherV3::AppDetails.new(
        contact_email: contact['email'], contact_website: contact['website'], contact_phone: contact['phone'],
        default_language: app['default_locale']
      )
      client.client.update_edit_detail(package, client.current_edit.id, details)
      client.commit_current_edit!
    end
    UI.success('Contact details updated')
  end

  # ---------------------------------------------------------------- declarations

  # Store declarations (Data safety, App Privacy, content rating answers): <app>/fastlane/declarations.yml.
  def declarations
    @declarations ||= begin
      path = File.join(fastlane_dir, 'declarations.yml')
      UI.user_error!("Missing #{path}. The ship-init skill writes it from the code.") unless File.exist?(path)
      YAML.safe_load(File.read(path)) || {}
    end
  end

  # Play's Data safety form as the CSV that Play Console exports (App content > Data safety > Export to CSV),
  # filled from declarations.yml. The blank export lives in templates/play: refresh it when Play adds questions.
  DATA_DELETION = { 'yes' => 'DATA_DELETION_YES', 'no' => 'DATA_DELETION_NO', 'auto_90_days' => 'DATA_DELETION_NO_AUTO_DELETED' }.freeze

  def data_safety_csv
    require 'csv'
    dir = ENV['SHIP_LOCAL'].to_s
    template = File.join(dir, 'templates', 'play', 'data_safety_template.csv')
    UI.user_error!('Set SHIP_LOCAL to the flutter-ship checkout (it holds the Data safety template)') unless !dir.empty? && File.exist?(template)
    ds = declarations['data_safety'] || UI.user_error!('declarations.yml has no data_safety section')
    data = ds['data'] || {}
    answers = {}
    put = ->(question, response, value) { answers[[question, response.to_s]] = value }
    put.('PSL_DATA_COLLECTION_COLLECTS_PERSONAL_DATA', nil, data.any? ? 'TRUE' : 'FALSE')
    if data.any?
      put.('PSL_DATA_COLLECTION_ENCRYPTED_IN_TRANSIT', nil, ds.fetch('encrypted_in_transit', true) ? 'TRUE' : 'FALSE')
      methods = Array(ds['account_creation'])
      methods = ['NONE'] if methods.empty?
      methods.each { |m| put.('PSL_SUPPORTED_ACCOUNT_CREATION_METHODS', "PSL_ACM_#{m}", 'TRUE') }
      put.('PSL_ACM_SPECIFY', nil, ds['account_creation_other']) if methods.include?('OTHER')
      put.('PSL_ACCOUNT_DELETION_URL', nil, ds['account_deletion_url']) unless methods == ['NONE']
      answer = ds.fetch('data_deletion', 'yes')
      deletion = DATA_DELETION[{ true => 'yes', false => 'no' }.fetch(answer, answer.to_s)] ||UI.user_error!("data_deletion: #{DATA_DELETION.keys.join(' | ')}")
      put.('PSL_SUPPORT_DATA_DELETION_BY_USER', deletion, 'TRUE')
      put.('PSL_DATA_DELETION_URL', nil, ds['data_deletion_url']) if ds['data_deletion_url']
    end
    rows = CSV.read(template)
    types = rows.drop(1).select { |q, _| q.start_with?('PSL_DATA_TYPES_') }.to_h { |q, r| [r, q] }
    data.each do |type, d|
      id = "PSL_#{type}"
      UI.user_error!("declarations.yml: unknown data type #{type} (see the PSL_DATA_TYPES_ rows of #{template})") unless types[id]
      put.(types[id], id, 'TRUE')
      usage = "PSL_DATA_USAGE_RESPONSES:#{id}"
      collected = Array(d['collected'])
      shared = Array(d['shared'])
      put.("#{usage}:PSL_DATA_USAGE_COLLECTION_AND_SHARING", 'PSL_DATA_USAGE_ONLY_COLLECTED', 'TRUE') if collected.any?
      put.("#{usage}:PSL_DATA_USAGE_COLLECTION_AND_SHARING", 'PSL_DATA_USAGE_ONLY_SHARED', 'TRUE') if shared.any?
      if collected.any?
        put.("#{usage}:PSL_DATA_USAGE_EPHEMERAL", nil, d['ephemeral'] ? 'TRUE' : 'FALSE')
        control = d['required'] ? 'PSL_DATA_USAGE_USER_CONTROL_REQUIRED' : 'PSL_DATA_USAGE_USER_CONTROL_OPTIONAL'
        put.("#{usage}:DATA_USAGE_USER_CONTROL", control, 'TRUE')
      end
      collected.each { |p| put.("#{usage}:DATA_USAGE_COLLECTION_PURPOSE", "PSL_#{p}", 'TRUE') }
      shared.each { |p| put.("#{usage}:DATA_USAGE_SHARING_PURPOSE", "PSL_#{p}", 'TRUE') }
    end
    used = []
    out = CSV.generate do |csv|
      csv << rows.first
      rows.drop(1).each do |row|
        key = [row[0], row[1].to_s]
        used << key if answers.key?(key)
        csv << [row[0], row[1], answers[key], *row[3..]]
      end
    end
    missing = answers.keys - used
    UI.user_error!("Not in the Data safety template: #{missing.map { |k| k.reject(&:empty?).join(' / ') }.join(', ')}") if missing.any?
    out
  end

  # ---------------------------------------------------------------- build

  def build_aab(name, code)
    args = (app.dig('android', 'build_args') || []).join(' ')
    with_signing do |env|
      with_env(env) do
        Dir.chdir(root) do
          Fastlane::Actions.sh("flutter build appbundle --release --build-name=#{name} --build-number=#{code} #{args}".strip)
        end
      end
    end
    aab = File.join(root, 'build', 'app', 'outputs', 'bundle', 'release', 'app-release.aab')
    UI.user_error!("No bundle at #{aab}") unless File.exist?(aab)
    verify_signature!(aab)
    aab
  end

  def tag!(name, code)
    tag = "android/#{name}+#{code}"
    _, status = Open3.capture2e('git', '-C', root, 'tag', '-a', tag, '-m', "Google Play #{name} (#{code})")
    return UI.important("Could not create git tag #{tag}") unless status.success?
    _, status = Open3.capture2e('git', '-C', root, 'push', '--quiet', 'origin', tag)
    UI.important("Tag #{tag} created but not pushed") unless status.success?
  end

  def first_upload_help(aab, name, code)
    UI.important('Google Play does not know this app yet. Google only lets the API manage an app after one bundle')
    UI.important('went up through Play Console. One-time steps:')
    UI.message("  1. Play Console > Create app (if not done): name '#{app['app_name']}', default language #{app['default_locale'] || locales.first}.")
    UI.message('  2. Test and release > Testing > Internal testing > Create new release.')
    UI.message('     Keep "Use Google-generated key" for Play App Signing.')
    UI.message("  3. Upload #{aab}")
    UI.message("     (package #{package}, version #{name}, code #{code}). Save; no need to roll it out.")
    UI.message('  4. Run the release lane again: from then on everything goes through the API.')
  end

  # ---------------------------------------------------------------- preflight

  def png_size(path)
    head = File.binread(path, 24)
    return nil unless head && head.bytesize == 24 && head[0, 8] == "\x89PNG\r\n\x1A\n".b
    head[16, 8].unpack('NN')
  end

  def text_length(path)
    File.exist?(path) ? File.read(path, encoding: 'UTF-8').strip.length : 0
  end

  # [errors, warnings] for things Google Play would reject.
  def preflight
    errors = []
    warnings = []
    gradle = %w[build.gradle.kts build.gradle].map { |f| File.join(root, 'android', 'app', f) }.find { |f| File.exist?(f) }
    if gradle
      src = File.read(gradle)
      app_id = src[/applicationId\s*=?\s*["']([^"']+)["']/, 1]
      errors << "applicationId is #{app_id}, ship.yml says #{package}" if app_id && app_id != package
      errors << "#{File.basename(gradle)} has no SHIP_KEYSTORE_PATH signing config (see templates/android)" unless src.include?('SHIP_KEYSTORE_PATH')
    elsif File.exist?(File.join(root, 'pubspec.yaml'))
      # Only a Flutter app builds through Gradle here. A Unity project uploads a bundle it
      # signed itself (see Pygmak's upload lane), so it has no android/app to check.
      errors << 'android/app/build.gradle(.kts) not found'
    end
    warnings << 'ship.yml has no privacy_url (Play requires one for most apps)' if app['privacy_url'].to_s.empty?

    locales.each do |locale|
      dir = File.join(metadata_dir, locale)
      unless Dir.exist?(dir)
        errors << "#{locale}: no metadata folder"
        next
      end
      { 'title.txt' => TITLE_MAX, 'short_description.txt' => SHORT_MAX, 'full_description.txt' => FULL_MAX }.each do |file, max|
        len = text_length(File.join(dir, file))
        errors << "#{locale}/#{file}: empty" if len.zero?
        errors << "#{locale}/#{file}: #{len} characters, Play allows #{max}" if len > max
      end
      Dir.glob(File.join(dir, 'changelogs', '*.txt')).each do |f|
        len = text_length(f)
        errors << "#{locale}/changelogs/#{File.basename(f)}: #{len} characters, Play allows #{CHANGELOG_MAX}" if len > CHANGELOG_MAX
      end
      images = File.join(dir, 'images')
      { 'icon.png' => [512, 512], 'featureGraphic.png' => [1024, 500] }.each do |file, size|
        path = File.join(images, file)
        if !File.exist?(path)
          (locale == locales.first ? errors : warnings) << "#{locale}/images/#{file}: missing"
        elsif png_size(path) != size
          errors << "#{locale}/images/#{file}: #{png_size(path)&.join('x')}, Play needs #{size.join('x')}"
        end
      end
      SCREENSHOT_DIRS.each do |kind|
        shots = Dir.glob(File.join(images, kind, '*.{png,jpg,jpeg}'))
        if kind == 'phoneScreenshots' && shots.size < 2
          errors << "#{locale}/images/#{kind}: #{shots.size} screenshots, Play needs at least 2"
        end
        errors << "#{locale}/images/#{kind}: #{shots.size} screenshots, Play allows 8" if shots.size > 8
        shots.each do |shot|
          w, h = png_size(shot)
          next unless w
          short, long = [w, h].minmax
          if short < 320 || long > 3840 || long > short * 2
            errors << "#{locale}/images/#{kind}/#{File.basename(shot)}: #{w}x#{h} is outside Play's limits"
          end
        end
      end
    end
    [errors, warnings]
  end

  def preflight!(metadata: true)
    errors, warnings = preflight
    errors = errors.reject { |e| e.include?('/') || e.end_with?('no metadata folder') } unless metadata
    warnings.each { |w| UI.important(w) }
    errors.each { |e| UI.error(e) }
    UI.user_error!("Preflight found #{errors.size} problem(s)") unless errors.empty?
    UI.success('Preflight passed')
  end
end

# ------------------------------------------------------------------ apple
#
# iOS builds need macOS. Off macOS, `ios release` starts the app's GitHub Actions workflow
# (templates/app/.github/workflows/ios-release.yml), which runs the same lane on a macOS runner.
# Everything else (bundle id, certificate, profile, build numbers) goes through the
# App Store Connect API, so it runs anywhere.
#
# Vault layout:
#   apple/asc/<name>.json.enc            App Store Connect API key {key_id, issuer_id, key}
#   apple/<team>/apns.json.enc           APNs auth key {key_id, team_id, key}
#   apple/<team>/devicecheck.json.enc    DeviceCheck key for Firebase App Check {key_id, team_id, key}
#   apple/<team>/distribution.json.enc   Apple Distribution certificate {id, key_pem, cert_der, expires}
#   apple/profiles/<bundle>.json.enc     App Store profile {id, uuid, name, content, expires}

require 'base64'
require 'rexml/document'

module Ship
  MAC = RUBY_PLATFORM.include?('darwin')
  IOS_WORKFLOW = 'ios-release.yml'

  module_function

  def ios
    { 'asc_key' => 'default' }.merge(app['ios'] || {})
  end

  def bundle_id
    ios['bundle_id'] || package
  end

  # The team comes with the App Store Connect key (vault_add_asc_key team_id:), so an app names
  # one Apple account. ios.team_id in ship.yml is only needed for keys stored without a team.
  def team_id
    key_team = asc_key['team_id']
    app_team = ios['team_id']
    if key_team && app_team && key_team != app_team
      UI.user_error!("ship.yml says ios.team_id #{app_team}, but the '#{ios['asc_key']}' key belongs to team #{key_team}. " \
                     'Remove ios.team_id from ship.yml.')
    end
    key_team || app_team ||
      UI.user_error!("The '#{ios['asc_key']}' key has no team: set ios.team_id in fastlane/ship.yml (developer.apple.com > Membership)")
  end

  module Vault
    module_function

    def asc_key_path(name) = "apple/asc/#{name}.json.enc"
    def apns_key_path(team) = "apple/#{team}/apns.json.enc"
    def devicecheck_key_path(team) = "apple/#{team}/devicecheck.json.enc"
    def distribution_path(team) = "apple/#{team}/distribution.json.enc"
    def profile_path(bundle) = "apple/profiles/#{bundle}.json.enc"
  end

  def asc_key
    @asc_key ||= begin
      rel = Vault.asc_key_path(ios['asc_key'])
      UI.user_error!("No App Store Connect key in the vault (#{rel}). Run vault_add_asc_key.") unless Vault.exist?(rel)
      JSON.parse(Vault.read(rel))
    end
  end

  # The hash fastlane actions take as api_key:.
  def asc_api_key
    k = asc_key
    { key_id: k['key_id'], issuer_id: k['issuer_id'], key: k['key'], duration: 1200, in_house: false }
  end

  # A Spaceship session for direct App Store Connect API calls.
  def connect_asc!
    return if @asc_connected
    k = asc_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(key_id: k['key_id'], issuer_id: k['issuer_id'], key: k['key'])
    @asc_connected = true
  end

  def pem_key!(path)
    text = File.read(path).strip
    UI.user_error!("#{path} is not a .p8 key") unless text.start_with?('-----BEGIN PRIVATE KEY-----')
    OpenSSL::PKey.read(text)
    text
  end

  # Capabilities the App Store Connect API cannot enable (no capabilityType): tick them by hand in
  # developer.apple.com > Identifiers > the App ID. ensure_profile! then checks the profile carries them.
  PORTAL_ONLY_CAPABILITIES = %w[APP_ATTEST].freeze

  # Registers the bundle id with the capabilities the app needs. Idempotent.
  def ensure_bundle_id!
    connect_asc!
    bid = Spaceship::ConnectAPI::BundleId.find(bundle_id)
    unless bid
      bid = Spaceship::ConnectAPI::BundleId.create(name: app['app_name'].to_s.gsub(/[^A-Za-z0-9 ]/, ''),
                                                   platform: 'IOS', identifier: bundle_id)
      UI.success("Registered bundle id #{bundle_id}")
    end
    have = bid.get_capabilities.map(&:capability_type)
    (ios['capabilities'] || ['PUSH_NOTIFICATIONS']).each do |cap|
      next if have.include?(cap)
      next if PORTAL_ONLY_CAPABILITIES.include?(cap) # checked on the profile instead
      bid.create_capability(cap)
      UI.success("Enabled #{cap} on #{bundle_id}")
    end
    bid
  end

  def distribution
    rel = Vault.distribution_path(team_id)
    Vault.exist?(rel) ? JSON.parse(Vault.read(rel)) : nil
  end

  def still_valid?(iso)
    Time.parse(iso) > Time.now + (7 * 86_400)
  end

  # One Apple Distribution certificate per team, shared by every app and machine. The private
  # key is made here and only ever stored encrypted in the vault.
  def ensure_distribution!
    connect_asc!
    d = distribution
    return d if d && still_valid?(d['expires']) && Spaceship::ConnectAPI::Certificate.all(filter: { id: d['id'] }).any?
    if d && d['imported_from']
      # The team manages its own certificates: replacing one is its call, not a silent new one.
      UI.user_error!("The imported certificate #{d['name']} has expired or was revoked. " \
                     'Import its replacement with `ios certificate import:path/to/distribution.p12`.')
    end
    key = OpenSSL::PKey::RSA.new(2048)
    csr = OpenSSL::X509::Request.new
    csr.version = 0
    csr.subject = OpenSSL::X509::Name.parse("/CN=#{owner}")
    csr.public_key = key.public_key
    csr.sign(key, OpenSSL::Digest.new('SHA256'))
    cert = begin
      Spaceship::ConnectAPI::Certificate.create(certificate_type: 'DISTRIBUTION', csr_content: csr.to_pem)
    rescue StandardError => e
      raise unless e.message =~ /maximum|already have a current|limit/i
      UI.user_error!("Apple refused a new distribution certificate for team #{team_id}: #{e.message}\n" \
                     'The team is at its limit. Ask its admin to export one it already uses (.p12 from Keychain Access) ' \
                     'and run `ios certificate import:path/to/distribution.p12`.')
    end
    x509 = OpenSSL::X509::Certificate.new(Base64.decode64(cert.certificate_content))
    save_distribution!({ 'id' => cert.id, 'key_pem' => key.to_pem }, x509, 'Created')
  end

  # A team that already uses its distribution certificates (often a client's, at Apple's limit)
  # shares one with the vault instead: the .p12 its admin exports from Keychain Access.
  def import_distribution!(path)
    UI.user_error!("No file at #{path}") unless File.file?(path)
    connect_asc!
    p12 = begin
      OpenSSL::PKCS12.new(File.binread(path), UI.password('Password of the .p12:'))
    rescue OpenSSL::PKCS12::PKCS12Error => e
      UI.user_error!("Could not open #{path}: #{e.message}. Either the password is wrong, or it is an old Keychain " \
                     'export (RC2) that OpenSSL 3 refuses: re-export it from a recent macOS, or convert it with `openssl pkcs12 -legacy`.')
    end
    x509 = p12.certificate
    UI.user_error!("#{path} holds a certificate without its private key") unless p12.key && x509.check_private_key(p12.key)
    team = x509.subject.to_a.find { |e| e[0] == 'OU' }&.at(1)
    UI.user_error!("This certificate belongs to team #{team}, ship.yml says #{team_id}") unless team == team_id
    UI.user_error!("This certificate expires #{x509.not_after.utc.strftime('%F')}: import a newer one") unless still_valid?(x509.not_after.utc.iso8601)
    live = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: 'DISTRIBUTION,IOS_DISTRIBUTION' })
                                             .find { |c| Base64.decode64(c.certificate_content.to_s) == x509.to_der }
    UI.user_error!("App Store Connect does not list this certificate for team #{team_id}: it was revoked") unless live
    save_distribution!({ 'id' => live.id, 'key_pem' => p12.key.to_pem, 'imported_from' => File.basename(path) }, x509, 'Imported')
  end

  def save_distribution!(d, x509, verb)
    d = d.merge('name' => x509.subject.to_a.find { |e| e[0] == 'CN' }&.at(1),
                'cert_der' => Base64.strict_encode64(x509.to_der),
                'expires' => x509.not_after.utc.iso8601, 'created_on' => Socket.gethostname)
    Vault.write(Vault.distribution_path(team_id), JSON.generate(d))
    Vault.publish!("Apple Distribution certificate for #{team_id}")
    UI.success("#{verb} certificate #{d['name']} (expires #{d['expires'][0, 10]})")
    d
  end

  # Keychain identity of the vault certificate: "Apple Distribution", or "iPhone Distribution"
  # for an older iOS Distribution certificate imported from a team.
  def signing_identity(dist)
    dist['name'].to_s[/\A(?:Apple|iPhone|iOS) Distribution/] || 'Apple Distribution'
  end

  def profile
    rel = Vault.profile_path(bundle_id)
    Vault.exist?(rel) ? JSON.parse(Vault.read(rel)) : nil
  end

  # App Store provisioning profile for the bundle id, signed by the vault certificate.
  # Made again when the certificate changed, the profile expires, or a capability was added
  # (Apple invalidates the profile then).
  def ensure_profile!(bid, dist)
    p = profile
    if p && p['certificate_id'] == dist['id'] && still_valid?(p['expires'])
      live = Spaceship::ConnectAPI::Profile.all(filter: { id: p['id'] }).first
      if live && live.profile_state == 'ACTIVE' && profile_missing_entitlements(p).empty?
        return p
      end
    end
    name = "flutter-ship #{bundle_id} AppStore"
    Spaceship::ConnectAPI::Profile.all(filter: { name: name }).each(&:delete!)
    prof = Spaceship::ConnectAPI::Profile.create(name: name, profile_type: 'IOS_APP_STORE',
                                                 bundle_id_id: bid.id, certificate_ids: [dist['id']])
    p = { 'id' => prof.id, 'uuid' => prof.uuid, 'name' => prof.name, 'content' => prof.profile_content,
          'expires' => Time.parse(prof.expiration_date.to_s).utc.iso8601, 'certificate_id' => dist['id'] }
    Vault.write(Vault.profile_path(bundle_id), JSON.generate(p))
    Vault.publish!("App Store profile for #{bundle_id}")
    UI.success("Created profile '#{name}' (expires #{p['expires'][0, 10]})")
    missing = profile_missing_entitlements(p)
    unless missing.empty?
      UI.user_error!("The new profile lacks #{missing.join(', ')} from Runner.entitlements: "                      'add the capability to ios.capabilities in ship.yml, or tick it on the App ID in '                      'developer.apple.com > Identifiers (App Attest has no API), then run `ios setup` again')
    end
    p
  end

  # Entitlement keys of ios/Runner/Runner.entitlements that the profile does not grant.
  def profile_missing_entitlements(p)
    file = File.join(root, 'ios', 'Runner', 'Runner.entitlements')
    return [] unless File.exist?(file) && p['content']
    plist_keys = lambda do |dict|
      dict ? dict.elements.to_a('key').map(&:text) : []
    end
    want = plist_keys.call(REXML::Document.new(File.read(file)).elements['plist/dict'])
    xml = Base64.decode64(p['content'])[/<\?xml.*<\/plist>/m]
    return [] unless xml
    top = REXML::Document.new(xml).elements['plist/dict']
    ent = top.elements.to_a.each_cons(2).find { |k, _| k.name == 'key' && k.text == 'Entitlements' }&.last
    want - plist_keys.call(ent)
  end

  def asc_app
    connect_asc!
    Spaceship::ConnectAPI::App.find(bundle_id)
  end

  # Raw App Store Connect API call, for resources Spaceship does not model (prices, availability...).
  # Returns the parsed JSON body, or nil on 404 (and on an empty body).
  def asc_request(klass, path, body = nil)
    connect_asc!
    uri = URI("https://api.appstoreconnect.apple.com/#{path}")
    req = klass.new(uri)
    req['Authorization'] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    if body
      req['Content-Type'] = 'application/json'
      req.body = JSON.generate(body)
    end
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
    return nil if res.code == '404'
    UI.user_error!("App Store Connect #{path}: HTTP #{res.code} #{res.body.to_s[0, 500]}") unless res.code.start_with?('2')
    res.body.to_s.empty? ? nil : JSON.parse(res.body)
  end

  def asc_get(path) = asc_request(Net::HTTP::Get, path)
  def asc_post(path, body) = asc_request(Net::HTTP::Post, path, body)
  def asc_patch(path, body) = asc_request(Net::HTTP::Patch, path, body)

  # Content rights, free price and countries from ship.yml (ios.content_rights, ios.countries).
  # Only free apps: a paid price needs the Paid Apps agreement and a price point choice made by hand.
  def asc_set_content_rights!(a)
    value = ios['content_rights'] == 'none' ? 'DOES_NOT_USE_THIRD_PARTY_CONTENT' : 'USES_THIRD_PARTY_CONTENT'
    asc_patch("v1/apps/#{a.id}", data: { type: 'apps', id: a.id, attributes: { contentRightsDeclaration: value } })
    UI.success("Content rights set: #{value}")
  end

  # ios.countries: App Store territory codes; ALL means every territory (and new ones as Apple adds them).
  # The first real code is the price base, e.g. [FRA, ALL].
  def asc_countries
    list = Array(ios['countries']).map(&:to_s)
    UI.user_error!('Set ios.countries in fastlane/ship.yml (App Store territory codes, e.g. [FRA] or [FRA, ALL])') if list.empty?
    list
  end

  def asc_worldwide?
    asc_countries.include?('ALL')
  end

  def asc_price_base
    asc_countries.find { |c| c != 'ALL' } || 'USA'
  end

  def asc_set_free_price!(a)
    base = asc_price_base
    free = asc_get("v1/apps/#{a.id}/appPricePoints?filter[territory]=#{base}&limit=200")['data']
           .find { |p| p['attributes']['customerPrice'].to_f.zero? }
    UI.user_error!("No free price point for #{base}") unless free
    asc_post('v1/appPriceSchedules', {
      data: { type: 'appPriceSchedules', relationships: {
        app: { data: { type: 'apps', id: a.id } },
        baseTerritory: { data: { type: 'territories', id: base } },
        manualPrices: { data: [{ type: 'appPrices', id: '${price}' }] }
      } },
      included: [{ type: 'appPrices', id: '${price}', attributes: { startDate: nil },
                   relationships: { appPricePoint: { data: { type: 'appPricePoints', id: free['id'] } } } }]
    })
    UI.success("Price set: free (base #{base})")
  end

  # Apple wants every territory in the request, available or not.
  def asc_set_availability!(a)
    all = asc_territories.keys
    unknown = asc_countries - all - ['ALL']
    UI.user_error!("Unknown App Store territories in ios.countries: #{unknown.join(' ')}") if unknown.any?
    ids = all.map { |code| "${#{code}}" }
    asc_post('v2/appAvailabilities', {
      data: { type: 'appAvailabilities', attributes: { availableInNewTerritories: asc_worldwide? }, relationships: {
        app: { data: { type: 'apps', id: a.id } },
        territoryAvailabilities: { data: ids.map { |id| { type: 'territoryAvailabilities', id: id } } }
      } },
      included: all.zip(ids).map do |code, id|
        { type: 'territoryAvailabilities', id: id, attributes: { available: asc_worldwide? || asc_countries.include?(code) },
          relationships: { territory: { data: { type: 'territories', id: code } } } }
      end
    })
    UI.success(asc_worldwide? ? 'Availability set: every territory' : "Availability set: #{asc_countries.join(' ')} only")
  end

  def app_record_help
    UI.important("App Store Connect has no app for #{bundle_id} yet. Apple does not let the API create it. One-time step:")
    UI.message('  App Store Connect > Apps > + > New App: platform iOS, a name unique on the store,')
    UI.message("  primary language #{app['default_locale'] || locales.first}, bundle id #{bundle_id}, SKU #{bundle_id}.")
    UI.message('  User Access: Limited Access (Full Access shows the app to every App Store Connect user, colleagues included).')
    UI.message('  Then run the lane again.')
  end

  # Next build number for iOS, shared with Play (shared_floor). nil when App Store Connect has no app yet.
  def next_build_number
    number = asc_next_build or return nil
    [number, shared_floor { with_play_key { |json_key| (play_version_codes(json_key)&.max || 0) + 1 } }].max
  end

  # Highest build number App Store Connect has seen for this app + 1, whatever the version.
  def asc_next_build
    a = asc_app or return nil
    builds = Spaceship::ConnectAPI::Build.all(app_id: a.id, sort: '-uploadedDate', limit: 50)
    (builds.map { |b| b.version.to_i }.max || 0) + 1
  end

  # Installs the vault certificate and profile in a throwaway keychain (macOS only).
  # One build at a time per Mac: every app's runner shares the user keychain search list, and a second build
  # resets it under the first ("Command CodeSign failed", "No signing certificate found"). GitHub concurrency
  # groups do not span repositories, so a lock file on the Mac queues the builds instead.
  def with_ios_signing(dist, prof)
    lock = File.open(File.join(Dir.home, '.ship-ios-signing.lock'), File::RDWR | File::CREAT, 0o600)
    unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      UI.message('Another iOS build is signing on this Mac: waiting for it to finish')
      lock.flock(File::LOCK_EX)
    end
    dir = Dir.mktmpdir('ship-ios-')
    keychain = File.join(dir, 'ship.keychain-db')
    kc_pass = SecureRandom.alphanumeric(24)
    p12_pass = SecureRandom.alphanumeric(24)
    key, der, pem, p12 = %w[key.pem cert.der cert.pem dist.p12].map { |f| File.join(dir, f) }
    File.write(key, dist['key_pem'])
    File.binwrite(der, Base64.decode64(dist['cert_der']))
    # The system openssl (LibreSSL) writes a PKCS#12 the keychain can read.
    capture!('/usr/bin/openssl', 'x509', '-inform', 'der', '-in', der, '-out', pem)
    capture!('/usr/bin/openssl', 'pkcs12', '-export', '-inkey', key, '-in', pem, '-out', p12, '-passout', "pass:#{p12_pass}")
    old_list = capture!('security', 'list-keychains', '-d', 'user').split.map { |k| k.delete('"') }
    capture!('security', 'create-keychain', '-p', kc_pass, keychain)
    capture!('security', 'set-keychain-settings', '-lut', '21600', keychain)
    capture!('security', 'unlock-keychain', '-p', kc_pass, keychain)
    capture!('security', 'import', p12, '-k', keychain, '-P', p12_pass, '-T', '/usr/bin/codesign', '-T', '/usr/bin/security')
    capture!('security', 'set-key-partition-list', '-S', 'apple-tool:,apple:,codesign:', '-s', '-k', kc_pass, keychain)
    capture!('security', 'list-keychains', '-d', 'user', '-s', keychain, *old_list)
    profiles = File.join(Dir.home, 'Library', 'MobileDevice', 'Provisioning Profiles')
    FileUtils.mkdir_p(profiles)
    File.binwrite(File.join(profiles, "#{prof['uuid']}.mobileprovision"), Base64.decode64(prof['content']))
    yield
  ensure
    if dir
      Open3.capture2e('security', 'list-keychains', '-d', 'user', '-s', *old_list) if old_list
      Open3.capture2e('security', 'delete-keychain', keychain)
      FileUtils.rm_rf(dir)
    end
    lock&.close
  end

  def build_ipa(name, number, dist, prof)
    export = File.join(Dir.mktmpdir('ship-export-'), 'ExportOptions.plist')
    File.write(export, [
      '<?xml version="1.0" encoding="UTF-8"?>',
      '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
      '<plist version="1.0"><dict>',
      '<key>method</key><string>app-store-connect</string>',
      "<key>teamID</key><string>#{team_id}</string>",
      '<key>signingStyle</key><string>manual</string>',
      "<key>signingCertificate</key><string>#{signing_identity(dist)}</string>",
      "<key>provisioningProfiles</key><dict><key>#{bundle_id}</key><string>#{prof['name']}</string></dict>",
      '<key>uploadSymbols</key><true/>',
      '</dict></plist>'
    ].join("\n"))
    args = (ios['build_args'] || []).join(' ')
    Dir.chdir(root) do
      Fastlane::Actions.sh("flutter build ipa --release --build-name=#{name} --build-number=#{number} --export-options-plist=#{export} #{args}".strip)
    end
    ipa = Dir.glob(File.join(root, 'build', 'ios', 'ipa', '*.ipa')).max_by { |f| File.mtime(f) }
    UI.user_error!('flutter build ipa produced no .ipa') unless ipa
    upload_crashlytics_dsyms
    ipa
  end

  # Apps with Firebase Crashlytics (CocoaPods) send the build's dSYMs, or their iOS crashes arrive
  # as bare addresses. A failed upload never sinks an otherwise good build.
  def upload_crashlytics_dsyms
    tool = File.join(root, 'ios', 'Pods', 'FirebaseCrashlytics', 'upload-symbols')
    gsp = File.join(root, 'ios', 'Runner', 'GoogleService-Info.plist')
    archive = Dir.glob(File.join(root, 'build', 'ios', 'archive', '*.xcarchive')).max_by { |f| File.mtime(f) }
    dsyms = archive && File.join(archive, 'dSYMs')
    return unless File.exist?(tool) && File.exist?(gsp) && dsyms && Dir.exist?(dsyms)
    out, status = Open3.capture2e(tool, '-gsp', gsp, '-p', 'ios', dsyms)
    return UI.success('dSYMs sent to Crashlytics') if status.success?
    UI.important("Crashlytics dSYM upload failed; this build's iOS crashes will be unsymbolicated:\n#{out.lines.last(5).join}")
  end

  # Bundle id, certificate and profile checked, then a signed .ipa (macOS only).
  def signed_ipa(name, number)
    bid = ensure_bundle_id!
    dist = ensure_distribution!
    prof = ensure_profile!(bid, dist)
    UI.message("Version #{name} (#{number})")
    with_ios_signing(dist, prof) do
      Fastlane::Actions::UpdateCodeSigningSettingsAction.run(
        path: File.join(root, 'ios', 'Runner.xcodeproj'),
        use_automatic_signing: false,
        team_id: team_id,
        targets: ['Runner'],
        build_configurations: ['Release'],
        code_sign_identity: signing_identity(dist),
        profile_name: prof['name']
      )
      build_ipa(name, number, dist, prof)
    end
  end

  def tag_ios!(name, number)
    tag = "ios/#{name}+#{number}"
    _, status = Open3.capture2e('git', '-C', root, 'tag', '-a', tag, '-m', "App Store #{name} (#{number})")
    return UI.important("Could not create git tag #{tag}") unless status.success?
    _, status = Open3.capture2e('git', '-C', root, 'push', '--quiet', 'origin', tag)
    UI.important("Tag #{tag} created but not pushed") unless status.success?
  end

  # ---------------------------------------------------------------- App Store listing
  #
  # fastlane/metadata/ios (deliver layout):
  #   <locale>/name.txt subtitle.txt description.txt keywords.txt promotional_text.txt
  #            support_url.txt marketing_url.txt privacy_url.txt [release_notes.txt]
  #   copyright.txt primary_category.txt [secondary_category.txt]
  #   review_information/{first_name,last_name,phone_number,email_address,notes}.txt
  #     (+ demo_user.txt / demo_password.txt, gitignored, only if the app needs a login)
  #   age_rating.json   App Store Connect ageRatingDeclaration attributes
  # fastlane/screenshots/<locale>/*.png   (shots.py frame --store ios)

  IOS_LIMITS = { 'name.txt' => 30, 'subtitle.txt' => 30, 'keywords.txt' => 100,
                 'promotional_text.txt' => 170, 'description.txt' => 4000, 'release_notes.txt' => 4000 }.freeze
  IOS_REQUIRED = %w[name.txt description.txt keywords.txt support_url.txt privacy_url.txt].freeze
  # App Store screenshot sizes it accepts for the required 6.9" / 6.5" iPhone slot, portrait or
  # landscape (a landscape game is shot sideways).
  IOS_PHONE_SIZES = [[1320, 2868], [1290, 2796], [1284, 2778], [1242, 2688]]
                    .flat_map { |w, h| [[w, h], [h, w]] }.freeze

  def ios_metadata_dir
    File.join(fastlane_dir, 'metadata', 'ios')
  end

  def ios_screenshots_dir
    File.join(fastlane_dir, 'screenshots')
  end

  def ios_preflight
    errors = []
    dir = ios_metadata_dir
    return ["#{dir} is missing: write the App Store listing (ship-listing skill)"] unless Dir.exist?(dir)
    locales.each do |loc|
      IOS_REQUIRED.each do |f|
        errors << "metadata/ios/#{loc}/#{f} is missing or empty" if text_length(File.join(dir, loc, f)).zero?
      end
      IOS_LIMITS.each do |f, max|
        len = text_length(File.join(dir, loc, f))
        errors << "metadata/ios/#{loc}/#{f} is #{len} characters (max #{max})" if len > max
      end
      kw = File.join(dir, loc, 'keywords.txt')
      if File.exist?(kw) && File.read(kw, encoding: 'UTF-8').include?(', ')
        errors << "metadata/ios/#{loc}/keywords.txt: separate keywords with commas only, spaces count against the 100"
      end
      shots = Dir.glob(File.join(ios_screenshots_dir, loc, '*.png'))
      phone = shots.select { |s| IOS_PHONE_SIZES.include?(png_size(s)) }
      errors << "screenshots/#{loc}: no 6.9\"/6.5\" iPhone screenshot (shots.py frame --store ios)" if phone.empty?
      errors << "screenshots/#{loc}: #{phone.size} iPhone screenshots (max 10)" if phone.size > 10
    end
    %w[copyright.txt primary_category.txt].each do |f|
      errors << "metadata/ios/#{f} is missing" if text_length(File.join(dir, f)).zero?
    end
    errors
  end

  # Off macOS: start the app's workflow, which runs `ios release` on a GitHub macOS runner.
  def dispatch_ios_workflow!(lane, runner: nil)
    workflow = File.join(root, '.github', 'workflows', IOS_WORKFLOW)
    unless File.exist?(workflow)
      UI.user_error!("iOS builds need macOS. Add .github/workflows/#{IOS_WORKFLOW} from templates/app (ship-init) or run this on a Mac.")
    end
    branch = capture!('git', '-C', root, 'rev-parse', '--abbrev-ref', 'HEAD').strip
    repo = capture!('git', '-C', root, 'remote', 'get-url', 'origin').strip
    where = route_ios_runner!(repo_slug(repo), File.read(workflow), runner)
    capture!('gh', 'workflow', 'run', IOS_WORKFLOW, '--ref', branch, '-R', repo, '-f', "lane=#{lane}")
    UI.success("ios #{lane} started on #{where} (branch #{branch}). Follow it with: gh run watch -R #{repo}")
  end

  # ---------------------------------------------------------------- the owner's Mac as build machine
  #
  # config.yml `mac_runner:` (the vault's copy counts too) makes the owner's Mac the iOS build
  # machine: a self-hosted GitHub runner per app repo (scripts/mac-runner.sh), picked by the repo
  # variable IOS_RUNNER, which the workflow templates read for runs-on. An app with no runner
  # there yet gets one through bootstrap_repo's mac-runner.yml, which runs on that repo's own
  # runner on the same Mac. ship.yml `ios.runner: github` opts an app out; runner:github on a lane
  # does it for one build.

  def mac_runner
    return nil if ios['runner'].to_s == 'github'
    cfg = machine['mac_runner']
    vault_cfg = File.join(Vault.local_dir, 'config.yml')
    cfg ||= (YAML.safe_load(File.read(vault_cfg), permitted_classes: [Date]) || {})['mac_runner'] if File.exist?(vault_cfg)
    cfg.is_a?(Hash) ? cfg : nil
  end

  def repo_slug(url)
    url[%r{github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?\z}, 1] || UI.user_error!("Not a GitHub remote: #{url}")
  end

  def gh_json(path)
    JSON.parse(capture!('gh', 'api', path))
  end

  def runners_with(slug, labels)
    gh_json("repos/#{slug}/actions/runners?per_page=100")['runners'].select do |r|
      (labels - r['labels'].map { |l| l['name'] }).empty?
    end
  end

  # Points the repo's iOS workflow at the Mac (registering its runner first when needed) or at
  # GitHub's runners. Returns where the build will run, for the message.
  def route_ios_runner!(slug, workflow_text, runner)
    cfg = runner.to_s == 'github' ? nil : mac_runner
    unless workflow_text.include?('IOS_RUNNER')
      UI.important("#{IOS_WORKFLOW} predates the Mac runner, so it builds on GitHub. Copy flutter-ship's templates/app (or unity) workflow to use the Mac.") if cfg
      return "GitHub's macOS runners"
    end
    unless cfg
      Open3.capture2e('gh', 'variable', 'delete', 'IOS_RUNNER', '-R', slug)
      return "GitHub's macOS runners (billed minutes)"
    end
    labels = Array(cfg['labels'] || %w[self-hosted macOS flutter-ship])
    runners = runners_with(slug, labels)
    if runners.empty?
      boot = cfg['bootstrap_repo'] || UI.user_error!('mac_runner: has no bootstrap_repo in config.yml')
      unless runners_with(boot, labels).any? { |r| r['status'] == 'online' }
        UI.user_error!("The Mac is offline (no online runner on #{boot}). Wake it (charger, logged in), " \
                       'or build on GitHub with runner:github.')
      end
      UI.message("No runner for #{slug} on the Mac yet: registering one through #{boot}...")
      register_mac_runner!(boot, slug)
      runners = runners_with(slug, labels)
      UI.user_error!("The Mac registered no runner for #{slug}: gh run list -w mac-runner.yml -R #{boot}") if runners.empty?
    end
    online = runners.find { |r| r['status'] == 'online' }
    unless online
      UI.user_error!("The Mac's runner for #{slug} is offline. Wake the Mac (charger, logged in), or build on GitHub with runner:github.")
    end
    capture!('gh', 'variable', 'set', 'IOS_RUNNER', '-R', slug, '--body', JSON.generate(labels))
    "the Mac (#{online['name']})"
  end

  def register_mac_runner!(boot, slug)
    runs = "repos/#{boot}/actions/workflows/mac-runner.yml/runs?per_page=1"
    before = gh_json(runs)['workflow_runs'].first&.dig('id')
    # The runner service on the Mac cannot use the Mac's own gh login, so the token comes from here.
    token = capture!('gh', 'api', '-X', 'POST', "repos/#{slug}/actions/runners/registration-token", '--jq', '.token').strip
    capture!('gh', 'workflow', 'run', 'mac-runner.yml', '-R', boot, '-f', "repo=#{slug}", '-f', 'action=add', '-f', "token=#{token}")
    run = nil
    40.times do
      sleep 3
      latest = gh_json(runs)['workflow_runs'].first
      next unless latest && latest['id'] != before
      run = latest
      break
    end
    UI.user_error!("mac-runner.yml did not start on #{boot}") unless run
    out, status = Open3.capture2e('gh', 'run', 'watch', run['id'].to_s, '-R', boot, '--exit-status', '--interval', '5')
    return if status.success?
    UI.user_error!("Registering the runner for #{slug} failed:\n#{out.lines.last(10).join}" \
                   "Log: gh run view #{run['id']} -R #{boot} --log")
  end

  # ---------------------------------------------------------------- in-app products
  #
  # ship.yml `products:` lists one-time purchases: a non-consumable on the App Store and a one-time
  # product on Play, with the same id and price on both stores.
  #
  #   products:
  #     - id: com.example.app.level_pack        # permanent: a store never lets an id be used again
  #       price: 4.99 EUR                       # exact in regions using that currency, converted by Play for
  #                                             # the others; on the App Store a price step in the base
  #                                             # territory's currency
  #       listing:                              # per store language: name max 35, description max 55
  #         en-US: { name: Level pack, description: Ten extra levels }
  #       review_screenshot: fastlane/products/level_pack.png   # optional, App Store review
  #       review_note: Unlocked from the level map.               # optional, App Store review

  IAP_NAME_MAX = 35        # App Store display name (Play allows 55)
  IAP_DESCRIPTION_MAX = 55 # App Store description (Play allows 200)
  PLAY_PURCHASE_OPTION = 'buy'
  # iPhone screenshot sizes App Store Connect takes for an in-app purchase review screenshot (portrait).
  IAP_REVIEW_SIZES = [[1320, 2868], [1290, 2796], [1284, 2778], [1242, 2688], [1179, 2556], [1242, 2208]].freeze

  def products
    Array(app['products'])
  end

  # "4.99 EUR" -> ["4.99", "EUR"], nil when malformed.
  def product_price(p)
    amount, currency = p['price'].to_s.split
    return nil unless amount.to_s =~ /\A\d+(\.\d{1,2})?\z/ && currency.to_s =~ /\A[A-Z]{3}\z/
    [amount, currency]
  end

  def products_preflight
    errors = []
    ids = products.map { |p| p['id'] }
    errors << 'products: the same id appears twice' if ids.uniq.size != ids.size
    products.each do |p|
      id = p['id'].to_s
      errors << "products: #{id.inspect} is not a valid id (lowercase letters, digits, . and _)" unless id =~ /\A[a-z0-9][a-z0-9._]{0,138}\z/
      errors << "products #{id}: write the price as '4.99 EUR'" unless product_price(p)
      listing = p['listing'] || {}
      errors << "products #{id}: no listing" if listing.empty?
      listing.each do |loc, l|
        name = l['name'].to_s
        description = l['description'].to_s
        errors << "products #{id} #{loc}: name is missing" if name.empty?
        errors << "products #{id} #{loc}: description is missing" if description.empty?
        errors << "products #{id} #{loc}: name is #{name.length} characters (max #{IAP_NAME_MAX})" if name.length > IAP_NAME_MAX
        if description.length > IAP_DESCRIPTION_MAX
          errors << "products #{id} #{loc}: description is #{description.length} characters (max #{IAP_DESCRIPTION_MAX})"
        end
      end
      shot = p['review_screenshot']
      errors << "products #{id}: no file at #{shot}" if shot && !File.file?(File.expand_path(shot, root))
    end
    errors
  end

  def play_money(amount, currency)
    units, cents = amount.split('.')
    Google::Apis::AndroidpublisherV3::Money.new(currency_code: currency, units: units.to_i, nanos: cents.to_s.ljust(9, '0').to_i)
  end

  # Creates or updates one product on Play (monetization.onetimeproducts), with one "buy" purchase option
  # priced in every region from the ship.yml price, and makes sure that option is active.
  def play_sync_product!(json_key, p)
    api = Google::Apis::AndroidpublisherV3
    service = play_client(json_key).client
    amount, currency = product_price(p)
    price = play_money(amount, currency)
    converted = service.convert_monetization_region_prices(package, api::ConvertRegionPricesRequest.new(price: price))
    # Regions in the ship.yml currency keep its exact price: Play's conversion treats it as before tax
    # (4.99 EUR came back as 5.99 in France). The other currencies take Play's conversion.
    configs = converted.converted_region_prices.map do |region, c|
      api::OneTimeProductPurchaseOptionRegionalPricingAndAvailabilityConfig.new(
        region_code: region, price: c.price.currency_code == currency ? price : c.price, availability: 'AVAILABLE'
      )
    end
    other = converted.converted_other_regions_price
    option = api::OneTimeProductPurchaseOption.new(
      purchase_option_id: PLAY_PURCHASE_OPTION,
      buy_option: api::OneTimeProductBuyPurchaseOption.new(legacy_compatible: true),
      regional_pricing_and_availability_configs: configs,
      new_regions_config: api::OneTimeProductPurchaseOptionNewRegionsConfig.new(
        availability: 'AVAILABLE', eur_price: other.eur_price, usd_price: other.usd_price
      )
    )
    listings = p['listing'].map do |loc, l|
      api::OneTimeProductListing.new(language_code: loc, title: l['name'], description: l['description'])
    end
    product = api::OneTimeProduct.new(package_name: package, product_id: p['id'], listings: listings, purchase_options: [option])
    saved = service.patch_monetization_onetimeproduct(package, p['id'], product, allow_missing: true,
                                                      regions_version_version: converted.region_version.version,
                                                      update_mask: 'listings,purchaseOptions')
    state = saved.purchase_options&.find { |o| o.purchase_option_id == PLAY_PURCHASE_OPTION }&.state
    unless state == 'ACTIVE'
      activate = api::ActivatePurchaseOptionRequest.new(package_name: package, product_id: p['id'],
                                                        purchase_option_id: PLAY_PURCHASE_OPTION)
      service.batch_monetization_onetimeproduct_purchase_option_update_states(
        package, p['id'], api::BatchUpdatePurchaseOptionStatesRequest.new(
          requests: [api::UpdatePurchaseOptionStateRequest.new(activate_purchase_option_request: activate)]
        )
      )
    end
    UI.success("Play: #{p['id']} at #{p['price']}, #{listings.size} language(s), active")
  rescue Google::Apis::ClientError => e
    hint = if e.message =~ /billing/i
             'Play takes products only once a build with the BILLING permission has been uploaded (a draft on any track is enough).'
           elsif e.status_code == 403
             "The service account needs 'Manage store presence' on this app (Play Console > Users and permissions)."
           end
    UI.user_error!("Play refused #{p['id']}: #{e.message}#{hint ? "\n#{hint}" : ''}")
  end

  # Every App Store territory with its currency, e.g. { 'FRA' => 'EUR' }.
  def asc_territories
    @asc_territories ||= asc_get('v1/territories?limit=200')['data'].to_h { |t| [t['id'], t['attributes']['currency']] }
  end

  # Follows `links.next` until the block finds what it looks for.
  def asc_find(path)
    while path
      page = asc_get(path)
      found = page['data'].find { |item| yield item }
      return found if found
      path = page.dig('links', 'next')&.sub('https://api.appstoreconnect.apple.com/', '')
    end
    nil
  end

  # Creates or updates one non-consumable: listing, price, availability, review screenshot and note.
  def asc_sync_product!(a, p)
    id = p['id']
    amount, currency = product_price(p)
    base = asc_price_base
    unless asc_territories[base] == currency
      UI.user_error!("products #{id}: the App Store prices it in #{asc_territories[base]} (base territory #{base}), " \
                     "ship.yml says #{currency}")
    end
    iap = asc_get("v1/apps/#{a.id}/inAppPurchasesV2?filter[productId]=#{id}")['data'].first
    unless iap
      iap = asc_post('v2/inAppPurchases', data: {
        type: 'inAppPurchases',
        attributes: { name: id[0, 64], productId: id, inAppPurchaseType: 'NON_CONSUMABLE', familySharable: false },
        relationships: { app: { data: { type: 'apps', id: a.id } } }
      })['data']
      UI.success("App Store: created #{id}")
    end
    iid = iap['id']
    if p['review_note'] && iap['attributes']['reviewNote'] != p['review_note']
      asc_patch("v2/inAppPurchases/#{iid}", data: { type: 'inAppPurchases', id: iid, attributes: { reviewNote: p['review_note'] } })
    end

    have = asc_get("v2/inAppPurchases/#{iid}/inAppPurchaseLocalizations?limit=50")['data']
    p['listing'].each do |loc, l|
      attrs = { name: l['name'], description: l['description'] }
      current = have.find { |h| h['attributes']['locale'] == loc }
      if current.nil?
        asc_post('v1/inAppPurchaseLocalizations', data: {
          type: 'inAppPurchaseLocalizations', attributes: attrs.merge(locale: loc),
          relationships: { inAppPurchaseV2: { data: { type: 'inAppPurchases', id: iid } } }
        })
      elsif current['attributes'].slice('name', 'description') != attrs.transform_keys(&:to_s)
        asc_patch("v1/inAppPurchaseLocalizations/#{current['id']}",
                  data: { type: 'inAppPurchaseLocalizations', id: current['id'], attributes: attrs })
      end
    end

    point = asc_find("v2/inAppPurchases/#{iid}/pricePoints?filter[territory]=#{base}&limit=200") do |pp|
      format('%.2f', pp['attributes']['customerPrice'].to_f) == format('%.2f', amount.to_f)
    end
    UI.user_error!("products #{id}: #{amount} #{currency} is not an App Store price step in #{base}. Pick a listed step, e.g. 4.99 or 5.99.") unless point
    asc_post('v1/inAppPurchasePriceSchedules', {
      data: { type: 'inAppPurchasePriceSchedules', relationships: {
        inAppPurchase: { data: { type: 'inAppPurchases', id: iid } },
        baseTerritory: { data: { type: 'territories', id: base } },
        manualPrices: { data: [{ type: 'inAppPurchasePrices', id: '${price}' }] }
      } },
      included: [{ type: 'inAppPurchasePrices', id: '${price}', attributes: { startDate: nil },
                   relationships: { inAppPurchaseV2: { data: { type: 'inAppPurchases', id: iid } },
                                    inAppPurchasePricePoint: { data: { type: 'inAppPurchasePricePoints', id: point['id'] } } } }]
    })

    territories = asc_worldwide? ? asc_territories.keys : asc_countries
    asc_post('v1/inAppPurchaseAvailabilities', data: {
      type: 'inAppPurchaseAvailabilities', attributes: { availableInNewTerritories: asc_worldwide? },
      relationships: { inAppPurchase: { data: { type: 'inAppPurchases', id: iid } },
                       availableTerritories: { data: territories.map { |t| { type: 'territories', id: t } } } }
    })

    asc_upload_review_screenshot!(iid, File.expand_path(p['review_screenshot'], root)) if p['review_screenshot']

    state = asc_get("v2/inAppPurchases/#{iid}")['data']['attributes']['state']
    UI.success("App Store: #{id} at #{p['price']}, #{p['listing'].size} language(s), state #{state}")
    UI.important("  #{id} still lacks a review screenshot (review_screenshot: in ship.yml)") if state == 'MISSING_METADATA' && !p['review_screenshot']
  end

  # Replaces the review screenshot when the file changed (Apple keeps the checksum).
  def asc_upload_review_screenshot!(iid, path)
    require 'digest'
    bytes = File.binread(path)
    # Apple refuses other sizes (IMAGE_INCORRECT_DIMENSIONS) after the upload: catch it here. A phone capture
    # fits once cropped to the 1290:2796 ratio and scaled.
    size = bytes.start_with?("\x89PNG".b) ? bytes[16, 8].unpack('NN') : nil
    unless IAP_REVIEW_SIZES.include?(size)
      UI.user_error!("#{path} is #{size&.join('x') || 'not a PNG'}: an App Store review screenshot must be an iPhone size " \
                     "(#{IAP_REVIEW_SIZES.map { |s| s.join('x') }.join(', ')})")
    end
    checksum = Digest::MD5.hexdigest(bytes)
    existing = asc_get("v2/inAppPurchases/#{iid}/appStoreReviewScreenshot")&.dig('data')
    return if existing && existing.dig('attributes', 'sourceFileChecksum') == checksum
    asc_request(Net::HTTP::Delete, "v1/inAppPurchaseAppStoreReviewScreenshots/#{existing['id']}") if existing
    shot = asc_post('v1/inAppPurchaseAppStoreReviewScreenshots', data: {
      type: 'inAppPurchaseAppStoreReviewScreenshots', attributes: { fileName: File.basename(path), fileSize: bytes.bytesize },
      relationships: { inAppPurchaseV2: { data: { type: 'inAppPurchases', id: iid } } }
    })['data']
    Spaceship::ConnectAPI::FileUploader.upload(shot['attributes']['uploadOperations'], bytes)
    asc_patch("v1/inAppPurchaseAppStoreReviewScreenshots/#{shot['id']}", data: {
      type: 'inAppPurchaseAppStoreReviewScreenshots', id: shot['id'], attributes: { uploaded: true, sourceFileChecksum: checksum }
    })
  end
end

# ------------------------------------------------------------------ ship status

# One checklist for every app: what a store-ready app needs on Play, the App Store and Firebase.
# Each item is read from the stores and Firebase when an API can tell, and otherwise from
# fastlane/ship-done.yml, where the lanes and skills that do a step record it (id: date). The result
# goes to the terminal and to fastlane/ship-status.json, which the dashboard (ship-status skill) reads.
module Ship
  module_function

  DONE_FILE = 'ship-done.yml'

  # Steps no API reports. Each one says who does it and where.
  RECORDED = {
    'play_data_safety' => 'Claude: `android data_safety` (ship-declare)',
    'play_app_content' => 'Claude: ship-declare fills App content in Play Console',
    'play_store_settings' => 'Claude: ship-declare sets category and tags (Store settings)',
    'play_integrity_link' => 'Claude in the browser (ship-declare), or you: Play Console > Protected with Play > Play Integrity API > ' \
                             'link the Firebase Cloud project. A 403 means the Play Console account has no IAM role on that project',
    'ios_app_privacy' => 'Claude writes the answers and, on your go, clicks Publish in App Store Connect > App Privacy (ship-declare 2 and 6)',
    'apns_key' => 'You: Firebase > Project settings > Cloud Messaging > Apple app > Production APNs auth key > Upload the team .p8 ' \
                  '(Key ID and team: `vault_list`); the picker is the OS one, so Claude cannot attach the file. Then tell Claude',
    'appcheck_ios' => 'App Attest only: Claude reads Firebase > App Check > the iOS app in the console and records it when it says Registered',
    'budget_alert' => 'Claude: `budget_alert` lane (Cloud Billing API, email alerts only, no cap)'
  }.freeze

  def done_path = File.join(fastlane_dir, DONE_FILE)

  # ship.yml `todo:` one-off tasks for this app ({id, title, how, after, minutes}), shown until `done:<id>`.
  def todos = Array(app['todo']).select { |t| t.is_a?(Hash) && t['id'] }

  def done
    @done ||= File.exist?(done_path) ? (YAML.safe_load(File.read(done_path), permitted_classes: [Date]) || {}) : {}
  end

  # Records a step as done today (additive: an existing date is kept).
  def record_done!(*ids)
    ids.flatten.map(&:to_s).each do |id|
      known = RECORDED.keys + todos.map { |t| t['id'].to_s }
      UI.user_error!("Unknown step '#{id}'. Recorded steps: #{known.join(', ')}") unless known.include?(id)
      done[id] ||= Date.today.to_s
    end
    header = "# Store and Firebase steps no API can read, with the day they were done (flutter-ship `ship_status`).\n"
    File.write(done_path, header + done.sort.to_h.to_yaml.sub(/\A---\n/, ''))
  end

  # Firebase ids from lib/firebase_options.dart (flutterfire), or nil when the app has no Firebase.
  def firebase
    @firebase ||= begin
      path = File.join(root, 'lib', 'firebase_options.dart')
      if File.exist?(path)
        text = File.read(path)
        { 'project' => text[/projectId:\s*'([^']+)'/, 1],
          'android' => text[/appId:\s*'([^']+:android:[^']+)'/, 1],
          'ios' => text[/appId:\s*'([^']+:ios:[^']+)'/, 1] }
      else
        {}
      end
    end
  end

  def pubspec_uses?(package)
    pubspec = File.join(root, 'pubspec.yaml')
    File.exist?(pubspec) && File.read(pubspec).match?(/^\s+#{Regexp.escape(package)}:/)
  end

  # Google API call with the user's Application Default Credentials, billed to the app's own project.
  def gcp_get(url) = gcp_request(Net::HTTP::Get, url)

  def gcp_request(verb, url, body = nil)
    @gcp_token ||= capture!('gcloud', 'auth', 'application-default', 'print-access-token').strip
    uri = URI(url)
    req = verb.new(uri)
    req['Authorization'] = "Bearer #{@gcp_token}"
    req['x-goog-user-project'] = firebase['project']
    if body
      req['Content-Type'] = 'application/json'
      req.body = JSON.generate(body)
    end
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
    # A Google API never turned on in this project answers 403 SERVICE_DISABLED: nothing was ever set up there.
    return nil if res.code == '403' && res.body.to_s.include?('SERVICE_DISABLED')
    # 404 on a per-app path: the app id is not in this project (stale firebase_options.dart).
    return :not_found if res.code == '404'
    UI.user_error!("#{uri.host}: HTTP #{res.code} #{res.body.to_s[0, 200]}") unless res.code.start_with?('2')
    JSON.parse(res.body.to_s.empty? ? '{}' : res.body)
  end

  NO_APP_CHECK = [:todo, 'App Check never set up in this Firebase project (open App Check in the console)'].freeze

  # nil when the project has never used App Check (its API is off).
  def app_check(path) = gcp_get("https://firebaseappcheck.googleapis.com/v1/projects/#{firebase['project']}/#{path}")

  def app_not_found(platform)
    [:todo, "#{platform} app #{firebase[platform.downcase]} not found in Firebase project #{firebase['project']}: " \
            'lib/firebase_options.dart is stale (rerun flutterfire configure)']
  end

  # Play Integrity registration stores the app signing SHA-256 on the Firebase Android app. Registrations made
  # before the console added appIntegrity / accountDetails to playIntegrityConfig only show up there.
  def android_sha256?
    certs = gcp_get("https://firebase.googleapis.com/v1beta1/projects/#{firebase['project']}/androidApps/#{firebase['android']}/sha")
    certs.is_a?(Hash) && (certs['certificates'] || []).any? { |c| c['certType'] == 'SHA_256' }
  end

  def project_number
    @project_number ||= gcp_get("https://firebase.googleapis.com/v1beta1/projects/#{firebase['project']}")['projectNumber']
  end

  # The billing account paying for the project ("billingAccounts/XXXXXX-XXXXXX-XXXXXX"), nil on the free plan,
  # :off while the Cloud Billing API is off in the project.
  def billing_account
    info = gcp_get("https://cloudbilling.googleapis.com/v1/projects/#{firebase['project']}/billingInfo")
    return :off unless info.is_a?(Hash)
    info['billingEnabled'] ? info['billingAccountName'] : nil
  end

  # Budgets on the billing account that cover this project (Firebase's own "Firebase Project <id>" ones count).
  # nil while the Budget API is off in the app's project (the calls are billed there); the budget_alert lane turns it on.
  def project_budgets(account)
    budgets = gcp_get("https://billingbudgets.googleapis.com/v1/#{account}/budgets")
    return nil unless budgets.is_a?(Hash)
    (budgets['budgets'] || [])
      .select { |b| (b.dig('budgetFilter', 'projects') || []).include?("projects/#{project_number}") }
  end

  # Live budget check. nil when the billing APIs cannot be read (the recorded step is used instead).
  def budget_alert_state
    account = billing_account or return [:na, 'no billing account (Spark plan)']
    return nil if account == :off
    budgets = project_budgets(account) or return nil
    return [:todo, "no budget on this project (#{account.split('/').last})"] if budgets.empty?
    money = budgets.first.dig('amount', 'specifiedAmount') || {}
    [:ok, "#{budgets.first['displayName']}: #{money['units'] || '?'} #{money['currencyCode']}/month"]
  rescue StandardError
    nil
  end

  # Functions enforce App Check when a callable says enforceAppCheck: true, or when the
  # ENFORCE_APP_CHECK switch (Badalone's pattern) is on in functions/.env.
  def functions_enforcement
    src = Dir.glob(File.join(root, 'functions', '**', '*.{ts,js}'))
             .reject { |f| f.match?(%r{/functions/(node_modules|lib|build)/}) || f.end_with?('.test.ts', '.test.js') }
    return nil if src.empty?
    code = src.map { |f| File.read(f) }.join("\n")
    env = Dir.glob(File.join(root, 'functions', '.env*')).map { |f| File.read(f) }.join("\n")
    on = code.match?(/enforceAppCheck:\s*true/) ||
         (code.include?('ENFORCE_APP_CHECK') && env.match?(/^ENFORCE_APP_CHECK=true/))
    if on then [:ok, 'callables enforce App Check']
    elsif code.include?('enforceAppCheck') then [:todo, 'wired but off: ENFORCE_APP_CHECK=true in functions/.env, then deploy']
    else [:todo, 'callables do not check App Check: add enforceAppCheck to onCall options']
    end
  end

  # [{id, group, title, state, detail, how}] for this app. state: ok | todo | wait | na | unknown.
  def status_items
    items = []
    add = lambda do |id, group, title, how = nil, &check|
      state, detail = begin
        result = check.call
        result.is_a?(Array) ? result : [result, nil]
      rescue StandardError => e
        [:unknown, e.message.lines.first.to_s.strip[0, 160]]
      end
      # ship.yml `hold: {step: reason}`: a step the user parks on purpose (e.g. an App Store review that waits on
      # paperwork) shows as waiting with that reason instead of a to-do.
      reason = (app['hold'] || {})[id]
      if reason && %i[todo unknown].include?(state.to_sym)
        detail = "on hold: #{reason}#{detail ? " (#{detail})" : ''}"
        state = :wait
      end
      items << { id: id, group: group, title: title, state: state.to_s, detail: detail, how: how || RECORDED[id] }
    end
    recorded = ->(id) { done[id] ? [:ok, "done #{done[id]}"] : [:todo, nil] }

    # Google Play
    releases = nil
    add.call('play_app', 'Google Play', 'App exists on Play', 'You: create the app and upload the first bundle (STORE_SETUP.md)') do
      next [:na, 'no Play service account in the vault'] unless play_key?
      with_play_key { |k| releases = track_releases(k) }
      [:ok, "#{releases.size} release(s)"]
    rescue StandardError => e
      app_missing_error?(e) ? [:todo, 'Play does not know the package yet'] : raise
    end
    add.call('play_production', 'Google Play', 'Production release out (live, or in review for a new app)', 'Claude: `android promote`, then send for review (ship-android)') do
      next [:unknown, 'Play not reachable'] unless releases
      prod = releases.select { |r| r[:track] == 'production' }
      live = prod.find { |r| r[:status] == 'completed' }
      next [:ok, live[:name]] if live
      next [:wait, "draft #{prod.first[:name]}: sent for review, or waiting to be sent"] if prod.any?
      [:todo, 'nothing on production']
    end
    # Play refuses a production release until these forms are complete, so a live app has them.
    on_production = items.last[:state] == 'ok'
    %w[play_data_safety play_app_content play_store_settings].each do |id|
      title = { 'play_data_safety' => 'Data safety sent', 'play_app_content' => 'App content forms filled',
                'play_store_settings' => 'Category and tags set' }[id]
      add.call(id, 'Google Play', title) do
        next recorded.call(id) if done[id] || !on_production
        [:ok, 'required by Play for production']
      end
    end

    # App Store
    if app['ios']
      asc = nil
      add.call('ios_app', 'App Store', 'App record exists', 'You: App Store Connect > Apps > + > New App') do
        asc = asc_app
        asc ? [:ok, "Apple ID #{asc.id}"] : [:todo, 'no App Store Connect record']
      end
      add.call('ios_live', 'App Store', 'Live on the App Store', 'Claude: ship-ios (TestFlight build, check, submit)') do
        next [:unknown, 'no app record'] unless asc
        states = asc.get_app_store_versions(filter: { platform: 'IOS' }).map { |v| [v.version_string, v.app_store_state] }
        live = states.find { |_, s| %w[READY_FOR_SALE READY_FOR_DISTRIBUTION].include?(s) }
        review = states.find { |_, s| %w[WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE PROCESSING_FOR_DISTRIBUTION].include?(s) }
        if live then [:ok, "#{live[0]} live#{review ? ", #{review[0]} #{review[1].downcase}" : ''}"]
        elsif review then [:wait, "#{review[0]} #{review[1].downcase.tr('_', ' ')}"]
        else [:todo, states.first ? "#{states.first[0]} #{states.first[1].downcase.tr('_', ' ')}" : 'no version']
        end
      end
      # Apple does not review a version without published App Privacy answers.
      reviewed = %w[ok wait].include?(items.last[:state])
      add.call('ios_app_privacy', 'App Store', 'App Privacy published') do
        done['ios_app_privacy'] || !reviewed ? recorded.call('ios_app_privacy') : [:ok, 'required by Apple for review']
      end
    end

    # Firebase security
    if firebase['project']
      push = (ios['capabilities'] || []).include?('PUSH_NOTIFICATIONS') || pubspec_uses?('firebase_messaging')
      add.call('appcheck_android', 'Security', 'App Check: Android registered (Play Integrity)',
               'Claude in the browser, or you: Firebase > App Check > Android app > Play Integrity, with the app signing SHA-256 from Play Console > App signing') do
        next [:na, 'no Android app in firebase_options.dart'] unless firebase['android']
        c = app_check("apps/#{firebase['android']}/playIntegrityConfig")
        next NO_APP_CHECK unless c
        next app_not_found('Android') if c == :not_found
        next :ok if c.key?('appIntegrity') || c.key?('accountDetails')
        android_sha256? ? [:ok, 'app signing SHA-256 on file'] : [:todo, 'not registered']
      end
      add.call('play_integrity_link', 'Security', 'Play Integrity linked to the Cloud project') { recorded.call('play_integrity_link') }
      if app['ios'] && firebase['ios']
        add.call('appcheck_ios', 'Security', 'App Check: iOS registered (DeviceCheck / App Attest)',
                 'You once per team: Apple Developer > Keys > + > DeviceCheck, download the .p8, `vault_add_devicecheck_key`; ' \
                 'then Claude: `appcheck_ios` lane (App Check API)') do
          dc = app_check("apps/#{firebase['ios']}/deviceCheckConfig")
          next NO_APP_CHECK unless dc
          next app_not_found('iOS') if dc == :not_found
          next [:ok, "DeviceCheck key #{dc['keyId']}"] if dc['keyId']
          # App Attest registrations do not show in the API: they are checked in the console and recorded.
          done['appcheck_ios'] ? [:ok, "App Attest, checked in console #{done['appcheck_ios']}"] : [:todo, 'no DeviceCheck key']
        end
        add.call('apns_key', 'Security', 'APNs key in Firebase (iOS push)') { push ? recorded.call('apns_key') : :na } if push
      end
      wanted = { 'firestore.googleapis.com' => 'cloud_firestore', 'firebasestorage.googleapis.com' => 'firebase_storage',
                 'identitytoolkit.googleapis.com' => 'firebase_auth', 'firebasedatabase.googleapis.com' => 'firebase_database' }
                 .select { |_, pkg| pubspec_uses?(pkg) }
      add.call('appcheck_enforced', 'Security', 'App Check enforced on Firebase services',
               'Claude, on your go once most requests are verified (App Check > APIs): Firestore, Storage, Authentication') do
        next :na if wanted.empty?
        services = app_check('services')
        next NO_APP_CHECK unless services.is_a?(Hash)
        modes = (services['services'] || []).to_h { |s| [s['name'].split('/').last, s['enforcementMode']] }
        off = wanted.keys.reject { |s| modes[s] == 'ENFORCED' }
        off.empty? ? [:ok, 'all enforced'] : [:todo, "not enforced: #{off.map { |s| s.split('.').first }.join(', ')}"]
      end
      add.call('appcheck_functions', 'Security', 'Cloud Functions require App Check',
               'Claude: enforceAppCheck on every callable, deploy once the apps send tokens') do
        functions_enforcement || :na
      end
      add.call('budget_alert', 'Security', 'Billing budget alert') { budget_alert_state || recorded.call('budget_alert') }
    end

    # Each app keeps its privacy page on its own site (<app>.coldsnap.fr on Firebase Hosting), never the shared
    # one on the personal website: App Review reads one policy for many apps as a sign of template apps
    # (guideline 4.3, Badalone/Seba/Sandlog/Pygmak, 2026-10-26).
    add.call('own_site', 'Listing', "Privacy page on the app's own site",
             'Claude: site/ (or web/privacy.html for a Flutter web app) on Firebase Hosting with <app>.coldsnap.fr ' \
             '(firebase-custom-domain), then privacy_url, the store URLs and the Play privacy policy (ship-declare)') do
      url = app['privacy_url'].to_s
      next [:todo, 'no privacy_url in ship.yml'] if url.empty?
      shared = URI(machine.dig('legal', 'generic_url').to_s).host
      next [:todo, "on the shared site #{shared}"] if shared && URI(url).host == shared
      code = Net::HTTP.get_response(URI(url)).code
      code == '200' ? [:ok, URI(url).host] : [:todo, "#{url} answers #{code}"]
    end

    # One-off tasks from ship.yml `todo:`, done once recorded with `ship_status done:<id>`.
    todos.each do |t|
      id = t['id'].to_s
      add.call(id, 'To do', t['title'] || id, t['how']) { recorded.call(id) }
      items.last.merge!(after: Array(t['after']).map(&:to_s), minutes: t['minutes'])
    end
    items
  end

  def status_report
    items = status_items
    marks = { 'ok' => '[x]', 'todo' => '[ ]', 'wait' => '[~]', 'na' => '[-]', 'unknown' => '[?]' }
    items.group_by { |i| i[:group] }.each do |group, list|
      UI.header(group)
      list.each do |i|
        line = "#{marks[i[:state]]} #{i[:title]}#{i[:detail] ? " (#{i[:detail]})" : ''}"
        case i[:state]
        when 'ok', 'na' then UI.message(line)
        when 'wait' then UI.important(line)
        else UI.error("#{line}\n      -> #{i[:how]}")
        end
      end
    end
    counted = items.reject { |i| i[:state] == 'na' }
    report = {
      app: app['app_name'], package: package, folder: File.basename(root), checked_at: Time.now.utc.iso8601,
      production: items.find { |i| i[:id] == 'play_production' }&.dig(:detail),
      ok: counted.count { |i| i[:state] == 'ok' }, total: counted.size, items: items
    }
    File.write(File.join(fastlane_dir, 'ship-status.json'), JSON.pretty_generate(report))
    ignore = File.join(root, '.gitignore')
    unless File.exist?(ignore) && File.read(ignore).include?('ship-status.json')
      File.open(ignore, 'a') { |f| f.write("#{File.exist?(ignore) && !File.read(ignore).end_with?("
") ? "
" : ''}fastlane/ship-status.json
") }
    end
    UI.success("#{report[:ok]}/#{report[:total]} done. Saved fastlane/ship-status.json")
    report
  end
end

# ------------------------------------------------------------------ lanes

desc 'Where this app stands: Play, App Store and Firebase security, one line per step (fastlane/ship-status.json).'
desc 'done:play_app_content,budget_alert records steps no API can read (fastlane/ship-done.yml)'
lane :ship_status do |options|
  Ship::Vault.sync!
  Ship.record_done!(options[:done].to_s.split(',').map(&:strip)) if options[:done]
  Ship.status_report
end


desc 'Add a Google Play service account key to the vault (name: defaults to "default")'
lane :vault_add_play_key do |options|
  path = File.expand_path(options[:path] || UI.user_error!('Pass path:/path/to/service-account.json'), Ship.root)
  json = File.read(path)
  UI.user_error!("#{path} is not a service account key") unless JSON.parse(json)['type'] == 'service_account'
  name = options[:name] || 'default'
  Ship::Vault.sync!
  Ship::Vault.write(Ship::Vault.play_key_path(name), json)
  Ship::Vault.publish!("Add Play service account #{name}")
  UI.success("Stored as google-play/#{name}. The original file can be deleted.")
end

desc 'List what the vault holds (no secrets are printed)'
lane :vault_list do
  Ship::Vault.sync!
  dir = Ship::Vault.local_dir
  UI.message("vault        #{dir}")
  Dir.glob(File.join(dir, 'android', '*', 'info.yml')).sort.each do |f|
    info = YAML.safe_load(File.read(f))
    UI.message("upload key   #{info['package_name']}  #{info['sha256']}  (#{info['created_at']}, #{info['created_on']})")
  end
  # Each store account a Play key can reach invites this email (Users and permissions).
  Dir.glob(File.join(dir, 'google-play', '*.json.enc')).sort.each do |f|
    email = JSON.parse(Ship::Vault.decrypt(File.binread(f)))['client_email']
    UI.message("play key     #{File.basename(f, '.json.enc')}  #{email}")
  end
  Dir.glob(File.join(dir, 'apple', 'asc', '*.json.enc')).sort.each do |f|
    team = JSON.parse(Ship::Vault.decrypt(File.binread(f)))['team_id']
    UI.message("asc key      #{File.basename(f, '.json.enc')}  team #{team || '? (set ios.team_id in ship.yml)'}")
  end
  Dir.glob(File.join(dir, 'apple', 'profiles', '*.json.enc')).sort.each { |f| UI.message("profile      #{File.basename(f, '.json.enc')}") }
  Dir.glob(File.join(dir, 'apple', '*', '{distribution,apns}.json.enc')).sort.each do |f|
    team = File.basename(File.dirname(f))
    UI.message("#{File.basename(f, '.json.enc').ljust(12)} team #{team}") unless %w[asc profiles].include?(team)
  end
end

desc 'Create or update the in-app products listed under products: in ship.yml, on Play and the App Store:'
desc 'listing, price and availability, from one file. only:android|ios limits it to one store'
lane :products do |options|
  UI.user_error!('No products: in fastlane/ship.yml (see "In-app products" in the flutter-ship README)') if Ship.products.empty?
  errors = Ship.products_preflight
  errors.each { |e| UI.error(e) }
  UI.user_error!("products: has #{errors.size} problem(s)") unless errors.empty?
  Ship::Vault.sync!
  only = options[:only].to_s
  unless only == 'ios'
    Ship.with_play_key { |json_key| Ship.products.each { |p| Ship.play_sync_product!(json_key, p) } }
  end
  next if only == 'android' || !Ship.app['ios']
  a = Ship.asc_app
  next Ship.app_record_help unless a
  Ship.products.each { |p| Ship.asc_sync_product!(a, p) }
  UI.message('A first in-app purchase is reviewed with an app version: App Store Connect > the version > ' \
             'In-App Purchases and Subscriptions > add it before Add for Review.')
end

platform :android do
  desc 'Build a signed bundle with the next free version code and upload it to Play (draft by default)'
  desc 'Options: track:internal|alpha|beta|production  status:draft|completed  metadata:true (also send listing + images)'
  desc '  version_code:N reuses the number iOS took when a previous Android upload was refused (must be new to Play)'
  lane :release do |options|
    Ship.preflight!(metadata: options[:metadata] == true)
    Ship::Vault.sync!
    Ship.require_keystore!
    Ship.with_play_key do |json_key|
      name, = Ship.pubspec_version
      code, on_play = Ship.next_version_code(json_key)
      if options[:version_code]
        # A retry after a refused upload, when iOS already took the shared number: Play never
        # saw it, so the Android build can still carry the same one.
        forced = options[:version_code].to_i
        seen = Ship.play_version_codes(json_key)&.max || 0
        UI.user_error!("Play has already seen version code #{seen}: version_code must be higher") if forced <= seen
        code = forced
      end
      UI.message("Version #{name} (#{code})")
      aab = Ship.build_aab(name, code)
      unless on_play
        Ship.first_upload_help(aab, name, code)
        next
      end
      metadata = options[:metadata] == true
      track = (options[:track] || Ship.play['track']).to_s
      status = (options[:status] || Ship.play['release_status']).to_s
      upload_to_play_store(
        package_name: Ship.package,
        json_key: json_key,
        aab: aab,
        track: track,
        release_status: status,
        version_name: "#{name} (#{code})",
        metadata_path: Ship.metadata_dir,
        skip_upload_apk: true,
        skip_upload_metadata: !metadata,
        skip_upload_images: !metadata,
        skip_upload_screenshots: !metadata,
        sync_image_upload: true
      )
      Ship.tag!(name, code)
      UI.success("#{name} (#{code}) is on the #{track} track as #{status}.")
    end
  end

  desc 'Build the signed bundle only (no upload). Handy for the first manual Play Console upload'
  lane :build do
    Ship.preflight!(metadata: false)
    Ship::Vault.sync!
    Ship.require_keystore!
    name, pubspec_code = Ship.pubspec_version
    code = if Ship.play_key?
             Ship.with_play_key { |json_key| Ship.next_version_code(json_key).first }
           else
             # Only safe before the first upload: Play cannot be asked which codes it has seen.
             UI.important('No Play service account in the vault: using the pubspec build number.')
             [pubspec_code, 1].max
           end
    UI.success("Built #{Ship.build_aab(name, code)} (#{name}, #{code})")
  end

  # Play's API cannot read the App content forms, but edits.validate refuses a release the console would refuse.
  desc 'Check, without changing anything, that Play would take a production release of the latest test build'
  desc 'Options: from: (default: the configured track) version_code:'
  lane :check do |options|
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      from = (options[:from] || Ship.play['track']).to_s
      code = options[:version_code]&.to_i || Ship.latest_code_on(json_key, from) ||
             UI.user_error!("Nothing on the #{from} track to check")
      validate = lambda do |status|
        Ship.with_edit(json_key) do |client|
          release = AndroidPublisher::TrackRelease.new(status: status, version_codes: [code.to_s])
          client.update_track('production', AndroidPublisher::Track.new(track: 'production', releases: [release]))
          client.validate_current_edit!
        end
        nil
      rescue StandardError => e
        e.message
      end
      error = validate.call('completed')
      if error.nil?
        UI.success("Play would take #{code} on production and send it for review: `android promote status:completed`.")
      elsif error =~ /draft app/i
        UI.important('The app has never been published: Play only takes a production draft.')
        draft_error = validate.call('draft')
        UI.user_error!("Production draft of #{code} refused: #{draft_error}") if draft_error
        UI.success("Production draft of #{code} accepted. Next: `android promote`, then Play Console > " \
                   'Publishing overview > Send for review (the console lists any form still missing).')
      else
        UI.user_error!("Production release of #{code} refused: #{error}")
      end
    end
  end

  desc 'Move a release between tracks. Defaults: from the configured track to production, as a draft'
  desc 'Options: from: to: status:draft|completed|inProgress rollout:0.1 version_code:'
  lane :promote do |options|
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      from = (options[:from] || Ship.play['track']).to_s
      to = (options[:to] || 'production').to_s
      status = (options[:status] || (options[:rollout] ? 'inProgress' : 'draft')).to_s
      code = options[:version_code]&.to_i || Ship.latest_code_on(json_key, from) ||
             UI.user_error!("Nothing on the #{from} track to promote")
      params = {
        package_name: Ship.package,
        json_key: json_key,
        track: from,
        track_promote_to: to,
        track_promote_release_status: status,
        release_status: status,
        version_code: code,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      }
      params[:rollout] = options[:rollout].to_s if options[:rollout]
      # After a rejection the console keeps the rejected release queued in Publishing
      # overview; the API commit does not replace it there. Seen on Maya, 2026-10-12.
      stale = Ship.track_releases(json_key).select do |r|
        r[:track] == to && r[:status] != 'completed' && !r[:codes].include?(code)
      end
      upload_to_play_store(params)
      UI.success("Version code #{code} promoted from #{from} to #{to} as #{status}.")
      unless stale.empty?
        UI.important("#{to} already had #{stale.map { |r| "#{r[:name]} (#{r[:status]})" }.join(', ')}. "                      "Play Console may still queue it: open Test and release > #{to.capitalize} > Edit release, "                      "pick build #{code}, save, then check Publishing overview before sending for review.")
      end
    end
  end

  desc 'Send the store listing (text, icon, feature graphic, screenshots) and contact details'
  lane :metadata do
    Ship.preflight!
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      # supply attaches listing uploads to an existing release: point it at the newest one.
      latest = Ship.track_releases(json_key).max_by { |r| r[:codes].max || 0 }
      UI.user_error!('No release on Play yet: upload the first bundle in Play Console') unless latest
      upload_to_play_store(
        package_name: Ship.package,
        json_key: json_key,
        track: latest[:track],
        version_code: latest[:codes].max,
        metadata_path: Ship.metadata_dir,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_changelogs: true,
        sync_image_upload: true
      )
      Ship.update_details(json_key)
    end
  end

  desc 'Send the Data safety form from fastlane/declarations.yml (dry:true only writes fastlane/data_safety.csv)'
  lane :data_safety do |options|
    csv = Ship.data_safety_csv
    if options[:dry]
      path = File.join(Ship.fastlane_dir, 'data_safety.csv')
      File.write(path, csv)
      next UI.message("Wrote #{path}")
    end
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      request = Google::Apis::AndroidpublisherV3::SafetyLabelsUpdateRequest.new(safety_labels: csv)
      Ship.play_client(json_key).client.data_application_safety(Ship.package, request)
    end
    Ship.record_done!('play_data_safety')
    UI.success('Data safety sent. It shows under App content > Data safety; send it for review from Publishing overview.')
  end

  desc 'Show what is on each Play track'
  lane :status do
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      releases = Ship.track_releases(json_key)
      UI.message('No releases yet') if releases.empty?
      releases.each do |r|
        fraction = r[:fraction] ? " #{(r[:fraction] * 100).round}%" : ''
        UI.message("#{r[:track].ljust(12)} #{r[:status]}#{fraction}  #{r[:name]}  codes #{r[:codes].join(',')}")
      end
    end
  end

  desc 'Print the version name and the next free version code'
  lane :version do
    Ship::Vault.sync!
    Ship.with_play_key do |json_key|
      name, = Ship.pubspec_version
      code, on_play = Ship.next_version_code(json_key)
      UI.message("#{name} (#{code})#{on_play ? '' : ' - app not on Play yet'}")
    end
  end

  desc 'Create the upload key in the vault, or import an existing one: keystore import:path/to/key.jks alias:upload,'
  desc 'or keystore properties:android/key.properties (paths and passwords from the file, nothing to type)'
  lane :keystore do |options|
    Ship::Vault.sync!
    if options[:properties]
      k = Ship.keystore_properties(File.expand_path(options[:properties].to_s, Ship.root))
      Ship.import_keystore!(k[:path], options[:alias] || k[:alias], store_pass: k[:password], key_pass: k[:key_password])
    elsif options[:import]
      Ship.import_keystore!(File.expand_path(options[:import].to_s, Ship.root), options[:alias])
    elsif !Ship.keystore?
      Ship.create_keystore!
    end
    UI.success("Upload key for #{Ship.package}: SHA-256 #{Ship.signing_data['sha256']}")
  end

  desc 'Check metadata, images and signing config against Play rules (offline)'
  lane :preflight do
    Ship.preflight!
  end

  desc 'Check this machine and the Play connection'
  lane :doctor do
    UI.message("keytool: #{Ship.keytool}")
    UI.message(Ship.capture!(Ship::WINDOWS ? 'flutter.bat' : 'flutter', '--version').lines.first.strip)
    Ship::Vault.sync!
    UI.success("Vault OK (#{Ship::Vault.local_dir})")
    UI.message(Ship.keystore? ? "Upload key: #{Ship.signing_data['sha256']}" : 'Upload key: none yet (run the keystore lane)')
    Ship.with_play_key do |json_key|
      codes = Ship.play_version_codes(json_key)
      if codes.nil?
        UI.important("Play does not know #{Ship.package} yet: the first bundle must be uploaded in Play Console")
      else
        UI.success("Play access OK, highest version code #{codes.max || 'none'}")
      end
    end
    errors, warnings = Ship.preflight
    (warnings + errors).each { |line| UI.important(line) }
  end
end

desc 'Add an Apple account: vault_add_asc_key path:AuthKey_X.p8 issuer_id: team_id: name: (key_id:)'
desc 'path: may also be a fastlane API key .json ({key_id, issuer_id, key}), which carries the ids'
lane :vault_add_asc_key do |options|
  path = File.expand_path(options[:path] || UI.user_error!('Pass path:/path/to/AuthKey_XXXX.p8'), Ship.root)
  json = path.end_with?('.json') ? JSON.parse(File.read(path)) : {}
  key_id = options[:key_id] || json['key_id'] || File.basename(path)[/AuthKey_(\w+)\.p8/, 1] || UI.user_error!('Pass key_id:')
  issuer = options[:issuer_id] || json['issuer_id'] || UI.user_error!('Pass issuer_id: (App Store Connect > Users and Access > Integrations)')
  team = options[:team_id] || UI.user_error!('Pass team_id: (developer.apple.com > Membership of that account)')
  name = options[:name] || UI.user_error!('Pass name: (the account, e.g. coldsnap or a client name; apps pick it with ios.asc_key)')
  Ship::Vault.sync!
  pem = json['key'] ? json['key'].strip : Ship.pem_key!(path)
  UI.user_error!("#{path} has no private key") unless pem.start_with?('-----BEGIN PRIVATE KEY-----') && OpenSSL::PKey.read(pem)
  data = { 'key_id' => key_id, 'issuer_id' => issuer, 'team_id' => team, 'key' => pem }
  Ship::Vault.write(Ship::Vault.asc_key_path(name), JSON.generate(data))
  Ship::Vault.publish!("Add App Store Connect key #{name}")
  UI.success("Stored as apple/asc/#{name} (team #{team}). Apps on this account: ios.asc_key: #{name}.")
end

desc 'Add an APNs auth key to the vault: vault_add_apns_key path:AuthKey_X.p8 team_id: (key_id:)'
lane :vault_add_apns_key do |options|
  path = File.expand_path(options[:path] || UI.user_error!('Pass path:/path/to/AuthKey_XXXX.p8'), Ship.root)
  key_id = options[:key_id] || File.basename(path)[/AuthKey_(\w+)\.p8/, 1] || UI.user_error!('Pass key_id:')
  team = options[:team_id] || UI.user_error!('Pass team_id:')
  Ship::Vault.sync!
  data = { 'key_id' => key_id, 'team_id' => team, 'key' => Ship.pem_key!(path) }
  Ship::Vault.write(Ship::Vault.apns_key_path(team), JSON.generate(data))
  Ship::Vault.publish!("Add APNs key for #{team}")
  UI.success("Stored as apple/#{team}/apns. Upload the same .p8 in Firebase > Project settings > Cloud Messaging.")
end

desc 'Add a DeviceCheck key (Firebase App Check on iOS) to the vault: vault_add_devicecheck_key path:AuthKey_X.p8 team_id: (key_id:)'
lane :vault_add_devicecheck_key do |options|
  path = File.expand_path(options[:path] || UI.user_error!('Pass path:/path/to/AuthKey_XXXX.p8'), Ship.root)
  key_id = options[:key_id] || File.basename(path)[/AuthKey_(\w+)\.p8/, 1] || UI.user_error!('Pass key_id:')
  team = options[:team_id] || UI.user_error!('Pass team_id:')
  Ship::Vault.sync!
  data = { 'key_id' => key_id, 'team_id' => team, 'key' => Ship.pem_key!(path) }
  Ship::Vault.write(Ship::Vault.devicecheck_key_path(team), JSON.generate(data))
  Ship::Vault.publish!("Add DeviceCheck key for #{team}")
  UI.success("Stored as apple/#{team}/devicecheck. Each app: `fastlane appcheck_ios`. Delete the .p8 file.")
end

# The APNs key has no Firebase API: the upload is a browser step (ship-declare). This writes the team's .p8 to
# a file for that upload; delete it right after. Nothing secret is printed.
desc 'Write the team APNs .p8 from the vault to a file for the Firebase upload: apns_p8 out:/tmp/AuthKey.p8'
lane :apns_p8 do |options|
  out = File.expand_path(options[:out] || UI.user_error!('Pass out:/path/to/AuthKey_XXXX.p8'))
  Ship::Vault.sync!
  team = Ship.team_id
  rel = Ship::Vault.apns_key_path(team)
  UI.user_error!("No APNs key in the vault (#{rel}). Run vault_add_apns_key.") unless Ship::Vault.exist?(rel)
  k = JSON.parse(Ship::Vault.read(rel))
  File.write(out, k['key'])
  File.chmod(0o600, out)
  UI.success("Wrote #{out}: Key ID #{k['key_id']}, team #{k['team_id'] || team}. Delete it after the upload.")
end

desc 'Register the iOS app for Firebase App Check with the team DeviceCheck key from the vault (App Check API)'
lane :appcheck_ios do
  Ship::Vault.sync!
  fb = Ship.firebase
  UI.user_error!('No iOS app in lib/firebase_options.dart') unless fb['project'] && fb['ios']
  team = Ship.team_id
  rel = Ship::Vault.devicecheck_key_path(team)
  UI.user_error!("No DeviceCheck key in the vault (#{rel}): Apple Developer > Keys > + > DeviceCheck, " \
                 'then vault_add_devicecheck_key path:AuthKey_X.p8 team_id:') unless Ship::Vault.exist?(rel)
  k = JSON.parse(Ship::Vault.read(rel))
  name = "projects/#{fb['project']}/apps/#{fb['ios']}/deviceCheckConfig"
  res = Ship.gcp_request(Net::HTTP::Patch, "https://firebaseappcheck.googleapis.com/v1/#{name}?updateMask=keyId,privateKey",
                         { 'name' => name, 'keyId' => k['key_id'], 'privateKey' => k['key'] })
  UI.user_error!('App Check API is off in this project: open App Check once in the Firebase console') unless res.is_a?(Hash)
  UI.success("DeviceCheck registered for #{fb['ios']} (key #{res['keyId']})")
  Ship.status_report
end

# Firebase makes a 1-unit budget when a project moves to Blaze; this adds one only where none covers the project.
desc 'Add a monthly budget with email alerts (50/90/100 %, no cap) on this Firebase project: budget_alert (amount:10)'
lane :budget_alert do |options|
  account = Ship.billing_account || UI.user_error!('The project has no billing account (Spark plan): nothing to watch')
  UI.user_error!("Turn on the Cloud Billing API in #{Ship.firebase['project']} first") if account == :off
  existing = Ship.project_budgets(account)
  unless existing
    project = Ship.firebase['project']
    Ship.gcp_request(Net::HTTP::Post, "https://serviceusage.googleapis.com/v1/projects/#{project}/services/billingbudgets.googleapis.com:enable", {})
    UI.message("Turned on the Cloud Billing Budget API in #{project}")
    existing = nil
    6.times { sleep 10; break if (existing = Ship.project_budgets(account)) }
    existing || UI.user_error!('The Budget API is still starting: run budget_alert again in a minute')
  end
  unless existing.empty?
    UI.success("Already covered: #{existing.map { |b| b['displayName'] }.join(', ')}")
    next Ship.status_report
  end
  currency = Ship.gcp_get("https://cloudbilling.googleapis.com/v1/#{account}")['currencyCode']
  body = {
    'displayName' => "#{Ship.firebase['project']} monthly",
    'budgetFilter' => { 'projects' => ["projects/#{Ship.project_number}"], 'calendarPeriod' => 'MONTH' },
    'amount' => { 'specifiedAmount' => { 'currencyCode' => currency, 'units' => (options[:amount] || 10).to_s } },
    'thresholdRules' => [0.5, 0.9, 1.0].map { |t| { 'thresholdPercent' => t, 'spendBasis' => 'CURRENT_SPEND' } }
  }
  b = Ship.gcp_request(Net::HTTP::Post, "https://billingbudgets.googleapis.com/v1/#{account}/budgets", body)
  UI.success("Budget #{b['displayName']}: #{body.dig('amount', 'specifiedAmount', 'units')} #{currency}/month, alerts to billing admins")
  Ship.status_report
end

platform :ios do
  desc 'Register the bundle id and its capabilities, make the distribution certificate and App Store profile'
  lane :setup do
    Ship::Vault.sync!
    bid = Ship.ensure_bundle_id!
    dist = Ship.ensure_distribution!
    prof = Ship.ensure_profile!(bid, dist)
    UI.success("Signing ready: certificate #{dist['name']}, profile '#{prof['name']}'")
    Ship.app_record_help unless Ship.asc_app
  end

  desc 'Share a distribution certificate the team already uses with the vault: certificate import:path/to/distribution.p12'
  lane :certificate do |options|
    path = options[:import] || UI.user_error!('Pass import:path/to/distribution.p12 (Keychain Access > the certificate > Export)')
    Ship::Vault.sync!
    UI.important("Replacing the vault certificate #{Ship.distribution['name']} for team #{Ship.team_id}") if Ship.distribution
    Ship.import_distribution!(File.expand_path(path.to_s, Ship.root))
    UI.success('Run `ios setup` to make the App Store profile with it. The .p12 file can be deleted.')
  end

  desc 'Build a signed .ipa without uploading (checks signing before the App Store Connect app exists)'
  lane :build do |options|
    next Ship.dispatch_ios_workflow!('build', runner: options[:runner]) unless Ship::MAC
    Ship::Vault.sync!
    name, pubspec_number = Ship.pubspec_version
    number = (Ship.asc_app && Ship.next_build_number) || [pubspec_number, 1].max
    UI.success("Built #{Ship.signed_ipa(name, number)}")
  end

  desc 'Check the App Store listing and screenshots against Apple limits (offline)'
  lane :preflight do
    errors = Ship.ios_preflight
    errors.each { |e| UI.error(e) }
    UI.user_error!("App Store preflight found #{errors.size} problem(s)") unless errors.empty?
    UI.success('App Store preflight passed')
  end

  desc 'Send the App Store listing: text, screenshots, age rating, review contact. No build, no submission'
  lane :metadata do
    errors = Ship.ios_preflight
    errors.each { |e| UI.error(e) }
    UI.user_error!("App Store preflight found #{errors.size} problem(s)") unless errors.empty?
    Ship::Vault.sync!
    next Ship.app_record_help unless Ship.asc_app
    name, = Ship.pubspec_version
    rating = File.join(Ship.ios_metadata_dir, 'age_rating.json')
    upload_to_app_store(
      api_key: Ship.asc_api_key,
      app_identifier: Ship.bundle_id,
      app_version: name,
      platform: 'ios',
      skip_binary_upload: true,
      metadata_path: Ship.ios_metadata_dir,
      screenshots_path: Ship.ios_screenshots_dir,
      overwrite_screenshots: true,
      app_rating_config_path: File.exist?(rating) ? rating : nil,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      force: true
    )
    UI.success("Listing for #{name} sent. Finish in App Store Connect: App Privacy, price and availability, then pick the build and submit.")
  end

  desc 'Submit the pubspec version for App Review with its TestFlight build, released when approved.'
  desc 'Sends the listing text and release_notes.txt with it (not screenshots). build:N picks the build (default: newest of this version)'
  lane :submit do |options|
    Ship::Vault.sync!
    a = Ship.asc_app
    next Ship.app_record_help unless a
    name, = Ship.pubspec_version
    builds = Spaceship::ConnectAPI::Build.all(app_id: a.id, sort: '-uploadedDate', limit: 20)
                                         .select { |b| b.app_version == name }
    build = options[:build] ? builds.find { |b| b.version == options[:build].to_s } : builds.first
    UI.user_error!("No TestFlight build of #{name}#{options[:build] ? " (#{options[:build]})" : ''}: run ios release first") unless build
    UI.user_error!("Build #{name} (#{build.version}) is #{build.processing_state}: wait until Apple has processed it") unless build.processing_state == 'VALID'
    rating = File.join(Ship.ios_metadata_dir, 'age_rating.json')
    upload_to_app_store(
      api_key: Ship.asc_api_key,
      app_identifier: Ship.bundle_id,
      app_version: name,
      build_number: build.version,
      platform: 'ios',
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: Ship.ios_metadata_dir,
      app_rating_config_path: File.exist?(rating) ? rating : nil,
      submit_for_review: true,
      automatic_release: true,
      submission_information: { add_id_info_uses_idfa: false },
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      force: true
    )
    UI.success("#{name} (#{build.version}) is waiting for App Review. It goes live by itself once approved.")
  end

  desc 'Show the App Store versions and the latest builds'
  lane :status do
    Ship::Vault.sync!
    a = Ship.asc_app
    next Ship.app_record_help unless a
    UI.message("#{a.name}  #{a.bundle_id}  SKU #{a.sku}  Apple ID #{a.id}")
    a.get_app_store_versions(filter: { platform: 'IOS' }).first(5).each do |v|
      UI.message("version #{v.version_string.ljust(8)} #{v.app_store_state}")
    end
    Spaceship::ConnectAPI::Build.all(app_id: a.id, sort: '-uploadedDate', limit: 5).each do |b|
      UI.message("build   #{b.app_version} (#{b.version})  #{b.processing_state}  #{b.uploaded_date}")
    end
  end

  desc 'Check everything App Store Connect needs before Add for Review. fix:true also sets content rights,'
  desc 'free price and countries (ios.content_rights, ios.countries in ship.yml) when they are missing. build:N picks that build'
  lane :check do |options|
    Ship::Vault.sync!
    fix = options[:fix].to_s == 'true'
    a = Ship.asc_app
    next Ship.app_record_help unless a
    missing = []
    check = lambda do |label, ok, detail = nil|
      line = "#{label}#{detail ? ": #{detail}" : ''}"
      ok ? UI.success(line) : UI.error(line)
      missing << label unless ok
    end

    editable = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED INVALID_BINARY]
    v = a.get_app_store_versions(filter: { platform: 'IOS' }).find { |x| editable.include?(x.app_store_state) }
    next UI.important('No editable App Store version (already in review or released).') unless v
    UI.message("Version #{v.version_string} (#{v.app_store_state})")

    vattr = Ship.asc_get("v1/appStoreVersions/#{v.id}")['data']['attributes']
    if options[:build]
      pick = Spaceship::ConnectAPI::Build.all(app_id: a.id, version: v.version_string, build_number: options[:build].to_s).first
      UI.user_error!("No build #{v.version_string} (#{options[:build]}) in App Store Connect yet") unless pick
      UI.user_error!("Build #{options[:build]} is #{pick.processing_state}, wait until Apple has processed it") unless pick.processing_state == 'VALID'
      v.select_build(build_id: pick.id)
      UI.success("Build #{options[:build]} picked for #{v.version_string}")
    end
    build = Ship.asc_get("v1/appStoreVersions/#{v.id}/build")&.dig('data')
    check.call('Build picked for the version', build, build && "#{build['attributes']['version']} (encryption declared: #{build['attributes']['usesNonExemptEncryption'].inspect})")
    check.call('Copyright', !vattr['copyright'].to_s.empty?, vattr['copyright'])
    UI.message("  release: #{vattr['releaseType']}")

    Ship.asc_get("v1/appStoreVersions/#{v.id}/appStoreVersionLocalizations")['data'].each do |loc|
      l = loc['attributes']
      gaps = %w[description keywords supportUrl].select { |k| l[k].to_s.strip.empty? }
      check.call("Listing #{l['locale']}", gaps.empty?, gaps.empty? ? nil : "missing #{gaps.join(', ')}")
      sets = Ship.asc_get("v1/appStoreVersionLocalizations/#{loc['id']}/appScreenshotSets?include=appScreenshots")
      counts = sets['data'].to_h { |s| [s['attributes']['screenshotDisplayType'], s.dig('relationships', 'appScreenshots', 'data')&.size.to_i] }
      iphone = counts.select { |t, n| t =~ /APP_IPHONE_(67|65)/ && n.positive? }
      check.call("Screenshots #{l['locale']}", iphone.any?, counts.map { |t, n| "#{t} #{n}" }.join(', '))
    end

    review = Ship.asc_get("v1/appStoreVersions/#{v.id}/appStoreReviewDetail")&.dig('data', 'attributes')
    if review
      gaps = %w[contactFirstName contactLastName contactEmail contactPhone].select { |k| review[k].to_s.empty? }
      check.call('Review contact', gaps.empty?, gaps.empty? ? review['contactEmail'] : "missing #{gaps.join(', ')}")
      demo = review['demoAccountRequired']
      # declarations.yml knows whether a feature needs an account; reviewers then need a demo one.
      decl = File.join(Ship.fastlane_dir, 'declarations.yml')
      needs = File.exist?(decl) && Ship.declarations.dig('play_content', 'sign_in_required')
      check.call('Sign-in for review', demo ? !review['demoAccountName'].to_s.empty? : !needs,
                 if demo then "demo account #{review['demoAccountName'].to_s.empty? ? 'required but empty' : 'set'}"
                 elsif needs then 'not required, but declarations.yml says a feature needs an account: add a demo account'
                 else 'not required'
                 end)
    else
      check.call('Review contact', false, 'no App Review information')
    end

    info = Ship.asc_get("v1/apps/#{a.id}/appInfos")['data'].find { |i| i['attributes']['appStoreState'] != 'READY_FOR_DISTRIBUTION' }
    if info
      cat = Ship.asc_get("v1/appInfos/#{info['id']}/primaryCategory")&.dig('data', 'id')
      check.call('Primary category', cat, cat)
      # Apple adds age rating questions over time; an unanswered one is null and blocks Add for Review
      # ("You must respond to the required age ratings questions").
      age = Ship.asc_get("v1/appInfos/#{info['id']}/ageRatingDeclaration")&.dig('data', 'attributes') || {}
      optional = %w[kidsAgeBand gracRatingClassificationNumber developerAgeRatingInfoUrl ageRatingOverride
                    ageRatingOverrideV2 koreaAgeRatingOverride seventeenPlus unrestrictedWebAccess]
      unanswered = age.reject { |k, v| optional.include?(k) || !v.nil? }.keys
      check.call('Age rating', !age.empty? && unanswered.empty?,
                 unanswered.empty? ? nil : "unanswered: #{unanswered.join(', ')} (App Information > Age Ratings > Edit)")
      Ship.asc_get("v1/appInfos/#{info['id']}/appInfoLocalizations")['data'].each do |loc|
        l = loc['attributes']
        check.call("Privacy policy URL #{l['locale']}", !l['privacyPolicyUrl'].to_s.empty?, l['privacyPolicyUrl'])
      end
    end

    rights = Ship.asc_get("v1/apps/#{a.id}")['data']['attributes']['contentRightsDeclaration']
    Ship.asc_set_content_rights!(a) if fix && !rights
    check.call('Content rights', rights || fix, rights || (fix ? 'just set' : nil))

    schedule = Ship.asc_get("v1/apps/#{a.id}/appPriceSchedule")&.dig('data', 'id')
    prices = schedule && Ship.asc_get("v1/appPriceSchedules/#{schedule}/manualPrices?include=appPricePoint")
    point = prices&.dig('included')&.find { |x| x['type'] == 'appPricePoints' }
    if fix && !point
      Ship.asc_set_free_price!(a)
      schedule = Ship.asc_get("v1/apps/#{a.id}/appPriceSchedule")&.dig('data', 'id')
      point = Ship.asc_get("v1/appPriceSchedules/#{schedule}/manualPrices?include=appPricePoint")&.dig('included')&.find { |x| x['type'] == 'appPricePoints' }
    end
    check.call('Price', point, point && "#{point['attributes']['customerPrice']} (base #{Ship.asc_get("v1/appPriceSchedules/#{schedule}/baseTerritory")&.dig('data', 'id')})")

    avail = Ship.asc_get("v1/apps/#{a.id}/appAvailabilityV2")&.dig('data', 'id')
    if fix && !avail
      Ship.asc_set_availability!(a)
      avail = Ship.asc_get("v1/apps/#{a.id}/appAvailabilityV2")&.dig('data', 'id')
    end
    territories = avail ? Ship.asc_get("v2/appAvailabilities/#{avail}/territoryAvailabilities?limit=200&include=territory")['data'] : []
    on = territories.select { |t| t['attributes']['available'] }.map { |t| t['relationships']&.dig('territory', 'data', 'id') || t['id'] }
    check.call('Availability', on.any?, on.any? ? "#{on.size} territor#{on.size == 1 ? 'y' : 'ies'} #{on.first(10).join(' ')}" : 'not set')

    # A first in-app purchase is reviewed with the app: it needs its metadata (review screenshot included), the
    # Paid Apps Agreement (Business > Agreements, not in the API) and to join the version's draft submission.
    iaps = Ship.asc_get("v1/apps/#{a.id}/inAppPurchasesV2?limit=200")&.dig('data') || []
    iaps.each do |i|
      state = i['attributes']['state']
      check.call("In-app purchase #{i['attributes']['productId']}", state != 'MISSING_METADATA', state)
    end
    if iaps.any?
      UI.important('In-app purchases need the Paid Apps Agreement Active (Business > Agreements), and a first purchase must be ' \
                   'ticked on the version page (In-App Purchases and Subscriptions) before Add for Review.')
    end

    UI.important('App Privacy (data types) is not readable through the API: check App Store Connect > App Privacy shows "Published".')
    if missing.empty?
      UI.success('Ready for Add for Review (once App Privacy is published).')
    else
      UI.user_error!("#{missing.size} item(s) missing: #{missing.join(', ')}")
    end
  end

  desc 'Show where this app builds iOS, and get it ready: on the Mac (config.yml mac_runner:) its runner is'
  desc 'registered there on first use. runner:github sends it back to GitHub. ios release does this by itself'
  lane :runner do |options|
    workflow = File.join(Ship.root, '.github', 'workflows', Ship::IOS_WORKFLOW)
    UI.user_error!("No .github/workflows/#{Ship::IOS_WORKFLOW}: copy it from flutter-ship's templates") unless File.exist?(workflow)
    repo = Ship.capture!('git', '-C', Ship.root, 'remote', 'get-url', 'origin').strip
    UI.success("iOS builds run on #{Ship.route_ios_runner!(Ship.repo_slug(repo), File.read(workflow), options[:runner])}")
  end

  desc 'Print the version name and the next free build number'
  lane :version do
    Ship::Vault.sync!
    name, = Ship.pubspec_version
    number = Ship.next_build_number
    next Ship.app_record_help unless number
    UI.message("#{name} (#{number})")
  end

  desc 'Build and upload to TestFlight. Off macOS this starts the iOS workflow on the owner Mac (config.yml mac_runner:),'
  desc 'registering its runner there on first use, or on GitHub. runner:github forces GitHub for this build'
  lane :release do |options|
    next Ship.dispatch_ios_workflow!('release', runner: options[:runner]) unless Ship::MAC
    Ship::Vault.sync!
    name, = Ship.pubspec_version
    number = Ship.next_build_number
    next Ship.app_record_help unless number
    ipa = Ship.signed_ipa(name, number)
    upload_to_testflight(api_key: Ship.asc_api_key, ipa: ipa, skip_waiting_for_build_processing: true)
    Ship.tag_ios!(name, number)
    UI.success("#{name} (#{number}) uploaded to TestFlight. It shows there once Apple has processed it.")
  end

  # Unity: the Editor exports the Xcode project (any OS); macOS compiles, signs and uploads it. Off macOS the
  # export travels as a zip on a draft GitHub release (a 1 GB Xcode project does not belong in git) and
  # .github/workflows/ios-release.yml (templates/unity) builds it on a macOS runner.
  desc 'Unity: send an Xcode export to TestFlight (xcode: build/iOS). Off macOS: draft release + macOS workflow'
  lane :unity_release do |options|
    xcode = File.expand_path((options[:xcode] || 'build/iOS').to_s, Ship.root)
    plist_path = File.join(xcode, 'Info.plist')
    UI.user_error!("No Xcode export at #{xcode}: build the iOS target from Unity first") unless File.exist?(plist_path)
    next unity_ios_upload(xcode: xcode) if Ship::MAC

    plist = File.read(plist_path)
    version = plist[%r{<key>CFBundleShortVersionString</key>\s*<string>([^<]+)</string>}, 1]
    number = plist[%r{<key>CFBundleVersion</key>\s*<string>([^<]+)</string>}, 1]
    tag = "ios-xcode/#{version}+#{number}"
    zip = File.join(Dir.tmpdir, "#{Ship.bundle_id}-xcode-#{version}-#{number}.zip")
    FileUtils.rm_f(zip)
    # Windows' own bsdtar writes zip with -a (a GNU tar from Git on PATH would read C: as a host);
    # symlinks and execute bits survive the round trip
    tar = Gem.win_platform? ? File.join(ENV.fetch('SystemRoot', 'C:/Windows'), 'System32', 'tar.exe') : 'bsdtar'
    Dir.chdir(xcode) { sh(tar, '-a', '-c', '-f', zip, '.') }
    repo = sh('git', '-C', Ship.root, 'remote', 'get-url', 'origin', log: false).strip
    # A draft release has no git tag behind it, so there is no tag to clean up
    sh('gh', 'release', 'delete', tag, '-R', repo, '--yes', error_callback: ->(_) {})
    sh('gh', 'release', 'create', tag, zip, '-R', repo, '--draft', '--title', "iOS Xcode export #{version} (#{number})",
       '--notes', 'Unity Xcode export for the iOS workflow. Deleted by the workflow once the build is on TestFlight.')
    workflow = File.join(Ship.root, '.github', 'workflows', 'ios-release.yml')
    where = Ship.route_ios_runner!(Ship.repo_slug(repo), File.exist?(workflow) ? File.read(workflow) : '', options[:runner])
    sh('gh', 'workflow', 'run', 'ios-release.yml', '-R', repo, '-f', "release=#{tag}")
    FileUtils.rm_f(zip)
    UI.success("#{version} (#{number}) sent to the iOS workflow on #{where}. Follow it with: gh run watch -R #{repo}")
  end

  private_lane :unity_ios_upload do |options|
    xcode = options[:xcode]
    Ship::Vault.sync!
    dist = Ship.ensure_distribution!
    prof = Ship.ensure_profile!(Ship.ensure_bundle_id!, dist)
    identity = Ship.signing_identity(dist)

    Dir.chdir(xcode) { sh('pod', 'install', '--repo-update') } if File.exist?(File.join(xcode, 'Podfile'))
    project = File.join(xcode, 'Unity-iPhone.xcodeproj')
    workspace = File.join(xcode, 'Unity-iPhone.xcworkspace')

    Ship.with_ios_signing(dist, prof) do
      update_code_signing_settings(path: project, use_automatic_signing: false, team_id: Ship.team_id,
                                   targets: ['Unity-iPhone'], build_configurations: ['Release'],
                                   code_sign_identity: identity, profile_name: prof['name'])
      # The framework is re-signed when the app embeds it: it needs the identity, never a profile
      update_code_signing_settings(path: project, use_automatic_signing: false, team_id: Ship.team_id,
                                   targets: ['UnityFramework'], build_configurations: ['Release'],
                                   code_sign_identity: identity)
      ipa = build_app(
        workspace: File.exist?(workspace) ? workspace : nil,
        project: File.exist?(workspace) ? nil : project,
        scheme: 'Unity-iPhone',
        configuration: 'Release',
        export_method: 'app-store',
        export_options: {
          teamID: Ship.team_id,
          signingStyle: 'manual',
          signingCertificate: identity,
          provisioningProfiles: { Ship.bundle_id => prof['name'] }
        },
        output_directory: File.join(Ship.root, 'build', 'ipa'),
        clean: true
      )
      upload_to_testflight(api_key: Ship.asc_api_key, ipa: ipa, skip_waiting_for_build_processing: true)
    end
    UI.success('Uploaded to TestFlight. It shows there once Apple has processed it.')
  end
end
